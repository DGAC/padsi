
{
    "friendly-name": "Private",
    "start-mode": "on-demand",
    "color": "#000000",
    "options": {
        "X11": true,
        "DRM": true
    },
    "web-proxy": null,
    "network": {
        "traffic-shaper": null,
        "dns-resolvers": [
            "86.54.11.213@853", "86.54.11.13@853"
        ],
        "out-rules": [
            {
                "action": "allow",
                "netres": "private"
            }
        ]
    },
    "mounts": {
        "{TEMPLATES}": {
            "source": "{TEMPLATES}",
            "mode": "ro"
        },
        "{DOCUMENTS}": {
            "source": "{DOCUMENTS}"
        },
        "{VIDEOS}": {
            "source": "{VIDEOS}"
        }
    },
    "apps": [
        "calibre-gui",
        "org.gnome.Terminal",
        "org.gnome.Nautilus"
    ]
}

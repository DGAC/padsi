    async def _load_zone_info_prefixes(self) -> dict[str,str]:
        """Load the prefixes-user-{self._uid}.txt file and return a dictionary
        where keys are the (mnt,net) namespaces and the value is the name of the associated zone
        """
        prefix=self._gconf.zones_infos_dir
        prefixes_user_file=f"{prefix}/prefixes-user-{self._uid}.txt"
        if not os.path.exists(prefixes_user_file):
            return {}
        lock_file=f"{prefix}/infos.lock"
        with open(lock_file, "w") as lockfd:
            fcntl.flock(lockfd, fcntl.LOCK_EX)
            try:
                res={}
                with open(prefixes_user_file, "rt") as fd:
                    for line in fd.readlines():
                        # will be like "mnt:[4026533288]net:[4026533291]=padsi.myzone\n"
                        (ns, zone)=line.split("=")
                        (_, zone)=zone.split(".")
                        res[ns]=zone.strip()
                return res
            except Exception as e:
                syslog.syslog(syslog.LOG_ERR, f"Problem reading info prefixes '{prefixes_user_file}': {str(e)}")
                return {}
            finally:
                # unlock the lock file
                fcntl.flock(lockfd, fcntl.LOCK_UN)
                lockfd.close()

    async def _update_zones_infos_files(self, args:dict):
        # steps:
        # 0. lock the JSON file
        # 1. write the data for this specific zone
        # 2. load the JSON file of each user and compute the aggregated data
        # 3. write the the aggregated data as JSON
        # 4. unlock the JSON file
        syslog.syslog(syslog.LOG_DEBUG, "Updating zones' infos with regards to namespaces")
        colors:dict=args["colors"]
        prefixes:dict=args["prefixes"]
        prefix=self._gconf.zones_infos_dir
        os.makedirs(prefix, exist_ok=True)
        lock_file=f"{prefix}/infos.lock"
        colors_agg_file=f"{prefix}/colors.json"
        colors_user_file=f"{prefix}/colors-user-{self._uid}.json"
        prefixes_agg_file=f"{prefix}/prefixes.txt"
        prefixes_user_file=f"{prefix}/prefixes-user-{self._uid}.txt"

        with open(lock_file, "w") as lockfd:
            fcntl.flock(lockfd, fcntl.LOCK_EX)
            try:
                if colors is None:
                    # remove the file for the user (cleanup)
                    try:
                        os.remove(colors_user_file)
                    except FileNotFoundError:
                        pass
                else:
                    # create /update the file for this user
                    with open(colors_user_file, "w") as user_fd:
                        json.dump(colors, user_fd)

                if prefixes is None:
                    # remove the file for the user (cleanup)
                    try:
                        os.remove(prefixes_user_file)
                    except FileNotFoundError:
                        pass
                else:
                    # create /update the file for this user
                    with open(prefixes_user_file, "wt") as user_fd:
                        for (key, value) in prefixes.items():
                            user_fd.write(f"{key}=padsi.{value}\n")

                # load all the JSON files and compute the aggregated data
                colors_agg_data={}
                prefixes_agg_data={}
                for fname in os.listdir(prefix):
                    if "-user-" in fname and fname.endswith(".json"):
                        fpath="---"
                        try:
                            fpath=os.path.join(prefix, fname)
                            data=json.load(open(fpath, "r"))
                            colors_agg_data.update(data)
                        except Exception as e:
                            syslog.syslog(syslog.LOG_ERR, f"Could not load JSON file '{fpath}': {str(e)}")
                    elif "-user-" in fname and fname.endswith(".txt"):
                        fpath="---"
                        try:
                            fpath=os.path.join(prefix, fname)
                            with open(fpath, "rt") as fd:
                                for line in fd.readlines():
                                    line=line.strip()
                                    (key, value)=line.split("=")
                                    prefixes_agg_data[key]=value
                        except Exception as e:
                            syslog.syslog(syslog.LOG_ERR, f"Could not load txt file '{fpath}': {str(e)}")

                # write back the data
                try:
                    json.dump(colors_agg_data, open(colors_agg_file, "w"))
                except Exception as e:
                    syslog.syslog(syslog.LOG_ERR, f"Could not write data to aggregated JSON file '{colors_agg_file}': {str(e)}")
                try:
                    with open(prefixes_agg_file, "wt") as fd:
                        for (key, value) in prefixes_agg_data.items():
                            fd.write(f"{key}={value}\n")
                except Exception as e:
                    syslog.syslog(syslog.LOG_ERR, f"Could not write data to aggregated text file '{prefixes_agg_file}': {str(e)}")
            finally:
                    # unlock the lock file
                    fcntl.flock(lockfd, fcntl.LOCK_UN)
                    lockfd.close()

    async def _fuse_cleanup(self, cleanup_args:dict):
        self._gconf.get_zone(cleanup_args["zone-name"])
        run_dir=self._gconf.get_user_run_dir(self._uid)

        # unmount resmaining FUSE mount points
        proc=await asyncio.create_subprocess_exec("/usr/bin/mount", "-l", stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
        (stdout, stderr)=await proc.communicate()
        if proc.returncode!=0:
            syslog.syslog(syslog.LOG_WARNING, f"Coulnd not list mount points: {stderr.decode() if stderr else stdout.decode()}")
            return

        paths:list[str]=[]
        dir_path=run_dir+"/" if run_dir[-1]!="/" else run_dir
        for line in stdout.decode().splitlines():
            # line will be like:
            # "fuse-zip on /run/padsi/user/1000/userfiles/dev/mymp type fuse.fuse-zip (rw,nosuid,nodev,relatime,user_id=1000,group_id=1000)"
            (_, _, mountpoint, _, mp_type, *_)=line.split()
            if mp_type.startswith("fuse") and mountpoint.startswith(dir_path):
                paths.append(mountpoint)

        paths.sort(reverse=True)
        for path in paths:
            proc=await asyncio.create_subprocess_exec("/usr/bin/umount", path, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
            (stdout, stderr)=await proc.communicate()
            if proc.returncode!=0:
                syslog.syslog(syslog.LOG_ERR, f"Could unmount FUSE mountpoint '{path}': {stderr.decode() if stderr else stdout.decode()}")

    async def _clean_user_runtime_dir(self):
        user_run_dir=self._gconf.get_user_run_dir(self._uid)
        if os.path.exists(user_run_dir):
            # we need to take a specific care about the userfiles directory as it may still contain some user data
            # if any bug prevented the mount points from being unmounted
            userfiles_zones_dir=ZoneUserFiles.compute_all_zones_dir(user_run_dir) # directories where all the per-zone filesystem are mounted
            if os.path.exists(userfiles_zones_dir):
                all_done=True
                for fname in os.listdir(userfiles_zones_dir):
                    fpath=os.path.join(userfiles_zones_dir, fname)
                    try:
                        os.rmdir(fpath)
                    except PermissionError as e:
                        all_done=False
                        syslog.syslog(syslog.LOG_WARNING, f"Could not remove userfiles directory '{fpath}': {str(e)} (filesystem may still be mounted)")
                    except Exception as e:
                        all_done=False
                        syslog.syslog(syslog.LOG_ERR, f"Could not remove userfiles directory '{fpath}': {str(e)} (exception type {type(e)})")

                if all_done:
                    try:
                        os.rmdir(userfiles_zones_dir)
                    except Exception as e:
                        syslog.syslog(syslog.LOG_ERR, f"Could not remove top userfiles directory '{userfiles_zones_dir}': {str(e)}")

            # remove the rest of the run directory for the zone where there is no data loss risk
            loop=asyncio.get_event_loop()
            all_done=True
            if os.path.exists(user_run_dir):
                for fname in os.listdir(user_run_dir):
                    fpath=os.path.join(user_run_dir, fname)
                    if fpath!=userfiles_zones_dir:
                        try:
                            await loop.run_in_executor(None, shutil.rmtree, fpath)
                            all_done=False
                        except Exception as e:
                            syslog.syslog(syslog.LOG_ERR, f"Could not remove directory user run dir '{fpath}': {str(e)}")
                if all_done:
                    try:
                        await loop.run_in_executor(None, shutil.rmtree, user_run_dir)
                    except Exception as e:
                        syslog.syslog(syslog.LOG_ERR, f"Could not remove user run dir '{user_run_dir}': {str(e)}")

    async def _zone_userfiles_setup(self, setup_args:dict) -> Message:
        zone_conf=self._gconf.get_zone(setup_args["zone-name"])
        run_dir=self._gconf.get_user_run_dir(self._uid)
        loop=asyncio.get_event_loop()
        res=await loop.run_in_executor(None, ZoneUserFiles.setup, self._gconf, zone_conf, self._uid, self._gid, run_dir, setup_args["syslog-prefix"])
        if isinstance(res, Exception):
            raise res
        return Message(MessageType.REPLY, res)

    async def _zone_userfiles_cleanup(self, cleanup_args:dict) -> Message:
        zone_conf=self._gconf.get_zone(cleanup_args["zone-name"])
        run_dir=self._gconf.get_user_run_dir(self._uid)
        loop=asyncio.get_event_loop()
        try:
            res=await loop.run_in_executor(None, ZoneUserFiles.cleanup, self._gconf, zone_conf, self._uid, self._gid, run_dir, cleanup_args["syslog-prefix"])
            if isinstance(res, Exception):
                syslog.syslog(syslog.LOG_ERR, f"Could not cleanup zone userfiles: {str(res)}")
                raise res
            return Message(MessageType.REPLY, res)
        except Exception as e:
            syslog.syslog(syslog.LOG_ERR, f"Error while cleanup of zone userfiles: {str(e)}")
            raise e

    async def _vm_management_priv(self, is_setup:bool, args:dict):
        zone_conf=self._gconf.get_zone(args["zone-name"])
        run_dir=self._gconf.get_user_run_dir(self._uid)
        vm_id=args["vm-id"]
        vm_conf=_get_vm_conf_for_usage(self._gconf, vm_id, self._uid, [VMUsage(args["vm-usage"])])
        discriminant=args["discriminant"]

        loop=asyncio.get_event_loop()
        avmf=await loop.run_in_executor(None, self._compute_avmf, vm_conf.directory, self._uid)
        if isinstance(avmf, Exception):
            raise avmf
        vmf=avmf.get_vm_files(self._uid)
        if vmf is None:
            raise Exception(f"No VM files found for user '{self._uid}'")
        vm_version=args.get("vm-version")
        if vm_version is None:
            raise Exception("CODEBUG: 'vm-version' not specified")
        vm_version=vmf.get_version_by_id(vm_version)
        if vm_version is None:
            msg=f"Unexpected None VM version in _vm_management_priv(), args['vm-version']={args['vm-version']}"
            syslog.syslog(syslog.LOG_WARNING, msg)
            if is_setup:
                raise Exception(msg)
        else:
            _check_privileges_on_vm_version(self._gconf, vm_id, vm_version, self._uid)
            if is_setup:
                await loop.run_in_executor(None, VMManagementFiles.priv_setup, zone_conf, vm_conf, vm_version,
                                           args["zone-home-dir"], self._uid, self._gid, run_dir, discriminant)
            else:
                await loop.run_in_executor(None, VMManagementFiles.priv_cleanup, zone_conf, vm_conf, vm_version,
                                           args["zone-home-dir"], self._uid, self._gid, run_dir, discriminant)


        if self._usb_devices_watcher is None:
            raise Exception("CODEBUG: self._usb_devices_watcher should not be None")
        self._usb_devices_watcher.reserve_device(args["device-id"], self._uid)

@dataclass
class UsbDevice:
    """Data associated to a USB device being redirected
    """
    device_id: str               # device's ID "<bus>/<device>" like "003/072"
    is_smartcard: bool           # True if device is a smartcard
    users: list[tuple[int,int]]  # list of [uid, PID] of the user and process having opened the device

@dataclass
class Reservation:
    device_id: str               # device's ID "<bus>/<device>" like "003/072"
    is_smartcard: bool|None      # True if device is a smartcard, None if not yet known
    uid: int                     # user for which it is reserved
    valid_to: int                # timestamp for the end of reservation validity

class USBDevicesMonitor:
    """Object which monitors USB devices' usage by processes
    and ensures that the PCSC daemon is running when it should and that virtual machines don't try to
    redirect the same USB device at the same time.
    """
    def __init__(self, logs_dir:str):
        self._logs_dir=logs_dir
        self._devices:dict[str,UsbDevice]={} # redirected USB devices, key=device ID
        self._reservations:dict[str,Reservation]={} # redirected USB devices, key=device ID
        self._pcscd_start_stop=padsi.misc.LateFunction(self._update_pcscd_service_state)

        self._reservation_delay=10
        self._pcsc_action_delay=0.5

    def _now(self) -> int:
        return int(datetime.datetime.now(datetime.UTC).timestamp())

    def _cleanup_reservations(self):
        """Remove reservations which have expired
        """
        now=self._now()
        expired:list[str]=[]
        for (device_id, resa) in self._reservations.items():
            if resa.valid_to<now:
                expired.append(device_id)
        for device_id in expired:
            del self._reservations[device_id]
        if len(expired)>0:
            self._pcscd_start_stop.start(self._pcsc_action_delay)

    def _check_usb_device_id_format(self, device_id:str):
        """Ensure that the device ID's format is correct
        """
        try:
            if not isinstance(device_id, str):
                raise Exception()
            (bus, dev)=device_id.split("/")
            bus=int(bus)
            dev=int(dev)
        except Exception:
            raise Exception(f"Invalid USB device ID '{device_id}'")

    async def _update_pcscd_service_state(self, *_):
        """Start or stop pcscd service depending on if any smartcard is currently being redirected
        """
        pcscd_must_run=True
        for (device_id, dev) in self._devices.items():
            if dev.is_smartcard:
                pcscd_must_run=False
                break

        if pcscd_must_run:
            self._cleanup_reservations()
            for (device_id, resa) in self._reservations.items():
                if resa.is_smartcard is None:
                    resa.is_smartcard=await self._usb_device_is_smartcard(device_id)
                if resa.is_smartcard:
                    pcscd_must_run=False
                break

        if _debug:
            syslog.syslog(syslog.LOG_DEBUG, f"Ensuring PCSC daemon {'active' if pcscd_must_run else 'stopped'}")
        (status, out, err)=await padsi.misc.asyncio_run(["systemctl", "start" if pcscd_must_run else "stop", "pcscd.socket", "pcscd.service"])
        if status!=0:
            syslog.syslog(syslog.LOG_ERR, f"Could not {'start' if pcscd_must_run else 'stop'} PCSCD service and socket: {err if err else out}")

    async def _mark_dev_opened(self, device_id:str, pid:int, uid:int):
        """Mark a USB devices as being opened (probably for redirection)
        """
        self._check_usb_device_id_format(device_id)
        is_smartcard=await self._usb_device_is_smartcard(device_id)
        if _debug:
            syslog.syslog(syslog.LOG_DEBUG, f"USBDEV: _mark_dev_opened({device_id=}, {pid=}, {uid=}), {is_smartcard=}")

        self._cleanup_reservations()
        if device_id in self._reservations:
            del self._reservations[device_id]

        dev=self._devices.get(device_id)
        if dev is None:
            self._devices[device_id]=UsbDevice(device_id, is_smartcard, [(uid, pid)])
        else:
            dev.users.append((uid, pid))
        if _debug:
            syslog.syslog(syslog.LOG_DEBUG, f"USBDEV: _mark_dev_opened() now: {self._devices=}")

    async def _mark_dev_closed(self, device_id:str, pid:int, uid:int):
        """Mark a USB devices as being closed by a process
        """
        self._check_usb_device_id_format(device_id)
        if _debug:
            syslog.syslog(syslog.LOG_DEBUG, f"USBDEV: _mark_dev_closed({device_id=}, {pid=}, {uid=}))")

        dev=self._devices.get(device_id)
        if dev is not None:
            for (duid, dpid) in dev.users:
                if duid==uid and dpid==pid:
                    dev.users.remove((duid, dpid))
                    break
            if len(dev.users)==0:
                del self._devices[device_id]
            self._pcscd_start_stop.start(self._pcsc_action_delay)
        if _debug:
            syslog.syslog(syslog.LOG_DEBUG, f"USBDEV: _mark_dev_closed() now: {self._devices=}")

    def get_devices_states(self, devices_ids:list[str]) -> dict[str,list[int]|int|None]:
        """For each specified device ID, get the IDs of the users who have a process having opened the specified USB device
        Also returns the UID of the user which made the reservation if the device is currently reserved
        """
        res={}
        for device_id in devices_ids:
            self._check_usb_device_id_format(device_id)

            dev=self._devices.get(device_id)
            if dev is not None:
                res[device_id]=list({uid for (uid, _pid) in dev.users})
            else:
                self._cleanup_reservations()
                resa=self._reservations.get(device_id)
                if resa is not None:
                    res[device_id]=resa.uid
                else:
                    res[device_id]=None
        return res

    def reserve_device(self, device_id:str, uid:int):
        """Allow to reserve a USB device for redirection for up to 10'
        """
        self._check_usb_device_id_format(device_id)
        if _debug:
            syslog.syslog(syslog.LOG_DEBUG, f"USBDEV: new reservation {device_id=}, {uid=}")

        if device_id in self._devices:
            raise Exception(f"USB device '{device_id}' is already being used")

        self._cleanup_reservations()
        resa=self._reservations.get(device_id)
        if resa is not None:
            if resa.uid!=uid:
                raise Exception(f"USB device '{device_id}' is already being reserved for user {resa.uid}")
            resa.valid_to=self._now()+self._reservation_delay
        else:
            self._reservations[device_id]=Reservation(device_id=device_id, is_smartcard=None,
                                                      uid=uid, valid_to=self._now()+self._reservation_delay)
            self._pcscd_start_stop.start(0)

    async def _usb_device_is_smartcard(self, device_id:str) -> bool:
        """Quick way to determine if device is a smartcard
        """
        self._check_usb_device_id_format(device_id)
        (status, out, _err)=await padsi.misc.asyncio_run(["lsusb", "-v", "-s", device_id.replace("/", ":")])
        if status!=0:
            raise Exception(f"Could not get infos. about USB device {device_id}")
        for line in out.splitlines():
            line=line.strip()
            if line.startswith("bInterfaceClass"):
                parts=line.split()
                if parts[1]=="11":
                    return True
        return False

    async def _initialize_state(self):
        """Make a pass on all the devices and get a status for each
        """
        for (dirpath, _, filenames) in os.walk("/dev/bus/usb"):
            for fname in filenames:
                devpath=f"{dirpath}/{fname}"
                device_id=f"{os.path.basename(dirpath)}/{fname}"
                (status, out, err)=await padsi.misc.asyncio_run(["lsof", "-Q", "-t", devpath])
                if status!=0:
                    syslog.syslog(syslog.LOG_WARNING, f"Could not determine if USB device '{device_id}' is actually redirected: {err if err else out}")
                else:
                    lines=out.splitlines()
                    if len(lines)>1:
                        syslog.syslog(syslog.LOG_WARNING, f"Unexpeded output of lsof: {out}, only taking 1st line into account")
                    elif len(lines)==1:
                        pid=int(lines[0])
                        (is_pcscd, uid)=await _get_process_attributes(pid)
                        if not is_pcscd and uid is not None:
                            await self._mark_dev_opened(device_id, pid, uid)
        self._pcscd_start_stop.start(self._pcsc_action_delay)

    async def run(self):
        await self._initialize_state()
        cenv=os.environ.copy()
        cenv["LOG_DIR"]=self._logs_dir
        process=await asyncio.create_subprocess_exec(
            os.path.join(_padsi_install_dir, "bin", "usb-monitor"),
            env=cenv,
            stdout=asyncio.subprocess.PIPE)
        if process.stdout is None:
            raise Exception("CODEBUG: Process.stdout should not be None")
        async for line in process.stdout:
            # line will be like:
            # OPEN;1000;158953;/dev/bus/usb/002/015
            # CLOSE;1000;158953;/dev/bus/usb/002/015
            try:
                line=line.strip().decode()
                if _debug:
                    syslog.syslog(syslog.LOG_DEBUG, f"USBDEV: notification: {line}")
                (action, uid, pid, path)=line.split(";")
                if not path.startswith("/dev/bus/usb/"):
                    raise Exception()
                device_id=path[13:]
                uid=int(uid)
                pid=int(pid)

                exe=None
                try:
                    # determine if the process having opened the device is PCSCD itself
                    dproc=psutil.Process(pid)
                    exe=dproc.exe()
                    if not exe:
                        raise Exception()
                    syslog.syslog(syslog.LOG_INFO, f"Process {exe} {action} device {path}")
                    is_pcscd=exe=="/usr/sbin/pcscd"
                except psutil.NoSuchProcess:
                    # process died
                    is_pcscd=False
                    if action=="OPEN":
                        continue

                # as we may also open the device to get information via lsusb, we must ignore
                # notifications which result from that action
                if exe=="/usr/bin/lsusb":
                    continue

                # finalize treatment
                if action=="OPEN":
                    is_redir=not is_pcscd
                else:
                    is_redir=False
                if _debug:
                    syslog.syslog(syslog.LOG_DEBUG, f"USB device {device_id=}, {pid=}, {uid=}, {is_redir=}")

                if is_redir:
                    await self._mark_dev_opened(device_id, pid, uid)
                else:
                    await self._mark_dev_closed(device_id, pid, uid)
                if _debug:
                    syslog.syslog(syslog.LOG_DEBUG, f"USB device {device_id=}, {pid=}, {uid=}, {is_redir=}, new situation => {self._devices}")
            except Exception as e:
                syslog.syslog(syslog.LOG_INFO, f"Ignoring an invalid notification from the USB devices monitor: '{line}' ({str(e)})")

        # Wait for process to finish
        syslog.syslog(syslog.LOG_INFO, "Waiting for USB devices monitor process to die")
        await process.wait()
        syslog.syslog(syslog.LOG_INFO, f"USB devices monitor terminated (status={process.returncode})")

@dataclass
class UserSession:
    """Data associated to a user being logged in
    """
    server: UserServer
    task: asyncio.Task # server run() task

class PadsiSystemService(padsi.misc.UserSessionNotifier):
    users_run_dir="/run/user"

    def __init__(self, userservice_path:str, gconf:Configuration):
        super().__init__()
        self._gconf=gconf
        self._traffic_shapers:set[TrafficShaper]=set()
        self._lock=asyncio.Lock()
        self._dns_resolvers:set[ipaddress.IPv4Address]=set()
        self._userservice_path=userservice_path
        self._user_sessions:dict[int,UserSession]={} # key=UID, value=user's UserSession

        # traffic shaper update mechanism
        self._tsp_tasks:list[asyncio.Task]=[]
        self._tsp_event=asyncio.Event()

        self._usb_watcher=USBDevicesMonitor(gconf.logs_dir)
        self._usb_watcher_task:asyncio.Task|None=None

        self._host_fw=firewall.Firewall(netns=None,
            log_denied_spec=firewall.LogSpec(_init_log_prefix, self._gconf.firewall_logs_group),
            objects_prefix="padsi")

    @property
    def lock(self) -> asyncio.Lock:
        return self._lock

    @property
    def host_fw(self) -> firewall.Firewall:
        return self._host_fw

    def _may_restart(self):
        """Restart the service if needed
        """
        need_restart_file=self._gconf.need_restart_file
        if not os.path.exists(need_restart_file):
            return

        # check the configuration is valid, just in case
        try:
            _=Configuration(self._gconf.config_dir)
        except Exception as e:
            syslog.syslog(syslog.LOG_ERR, f"Did not restart PADSI service as configuration is invalid: {str(e)}")
            return

        # if the global configuration defines a program to run to check if now is a good time to restart the
        # PADSI service, then run it now as the 'padsi' user
        if self._gconf.need_restart_check is not None and os.path.exists(self._gconf.need_restart_check):
            try:
                padsi_user=pwd.getpwnam("padsi")
            except KeyError:
                raise Exception("Unable to find the 'padsi' user")

            uid=os.geteuid()
            gid=os.getgid()
            try:
                syslog.syslog(syslog.LOG_DEBUG, f"Changing user {uid} --> {padsi_user.pw_uid}")
                os.setegid(padsi_user.pw_uid)
                os.seteuid(padsi_user.pw_gid)

                proc=subprocess.run([self._gconf.need_restart_check])
                if proc.returncode!=0:
                    syslog.syslog(syslog.LOG_INFO, f"The '{self._gconf.need_restart_check}' program returned {proc.returncode}, not restarting yet")
                    return
            finally:
                syslog.syslog(syslog.LOG_DEBUG, f"Reverting user {padsi_user.pw_uid} --> {uid}")
                os.setegid(gid)
                os.seteuid(uid)

        syslog.syslog(syslog.LOG_INFO, "Signaling the PADSI service to restart (SIGTERM)")
        try:
            os.remove(need_restart_file)
        except Exception as e:
            syslog.syslog(syslog.LOG_ERR, f"Failed to remove PADSI restart file '{need_restart_file}': {str(e)}")
        signal.raise_signal(signal.SIGTERM)

    def declare_traffic_shaper(self, tshaper:TrafficShaper):
        """Declare a traffic shaper which will be setup and destroyed when appropriate
        """
        if tshaper not in self._traffic_shapers:
            self._traffic_shapers.add(tshaper)

    def _update_dns_resolvers_list(self):
        """Parse /etc/resolv to determine the current DNS resolvers
        """
        counter=0
        while counter<5:
            resolvers:set[ipaddress.IPv4Address]=set()
            try:
                with open("/etc/resolv.conf", "rt") as fd:
                    for line in fd.readlines():
                        if line.startswith("nameserver"):
                            try:
                                (_, addr)=line.split(maxsplit=1)
                                (addr, *_)=addr.split("%")
                                resolvers.add(ipaddress.IPv4Address(addr.strip()))
                            except Exception:
                                pass
            except Exception as e:
                syslog.syslog(syslog.LOG_ERR, f"Failed to parse /etc/resolv.conf: {str(e)}")
            if len(resolvers)>0:
                self._dns_resolvers=resolvers
                break
            else:
                counter+=1
                time.sleep(0.5)

    def _setup_traffic_shapers(self):
        """This tasks adapt traffic shapers when it receives an event
        """
        # set up all the traffic shapers (will create the network namespaces)
        for tshaper in self._traffic_shapers:
            # setup if necessary
            if tshaper.need_setup:
                try:
                    lower_net=self._gconf.get_unused_low_network() if tshaper.need_veth else None
                    syslog.syslog(syslog.LOG_INFO, f"Setting up traffic shaper {tshaper.name} (netns {tshaper.net_ns}) with lower_net {lower_net}")
                    tshaper.setup(self._host_fw, lower_net)
                    syslog.syslog(syslog.LOG_INFO, f"Finished setting up traffic shaper {tshaper.name} (netns {tshaper.net_ns})")
                except Exception as e:
                    syslog.syslog(syslog.LOG_ERR, f"Could not set uptraffic shaper {tshaper.name} (netns {tshaper.net_ns}): {str(e)}")


    async def _adapt_traffic_shapers(self):
        """This tasks adapt traffic shapers when it receives an event
        """
        # adapt traffic shapers when the self._tsp_event is set
        while True:
            try:
                await self._tsp_event.wait()
                self._tsp_event.clear()

                syslog.syslog(syslog.LOG_INFO, "Adapting traffic shapers: updating list of DNS resolvers")
                current_dns_resolvers=self._dns_resolvers
                self._update_dns_resolvers_list()
                syslog.syslog(syslog.LOG_INFO, f"Adapting traffic shapers: updated DNS resolvers list to {self._dns_resolvers} vs previously {current_dns_resolvers}")

                # check if anything needs to be done
                action_required=current_dns_resolvers!=self._dns_resolvers
                if not action_required:
                    for tshaper in self._traffic_shapers:
                        if not tshaper.functionnal:
                            action_required=True
                            break

                # adapt traffic shapers as necessary
                if action_required:
                    # determine if any traffic shaper needs the DNS resolution (which takes place in the "init" NS, so it's not a per traffic shapper
                    # authorization)
                    try:
                        dns_resolv_needed=False
                        for tshaper in self._traffic_shapers:
                            if tshaper.need_dns_resolution:
                                dns_resolv_needed=True
                                break
                    except Exception as e:
                        dns_resolv_needed=True
                        syslog.syslog(syslog.LOG_ERR, f"Could not determine if all traffic shapers need DNS resolution (assuming yes): {str(e)}")

                    # temporary allow DNS resolution if necessary for traffic shaper
                    allowed_dns_flows:list[firewall.NetFlow]=[]
                    if dns_resolv_needed:
                        for ip in self._dns_resolvers:
                            flow=None
                            try:
                                flow=firewall.NetFlow(None, firewall.Endpoint.from_repr(f"{str(ip)}^udp^53"))
                                syslog.syslog(syslog.LOG_INFO, f"Adapting traffic shapers: allow tmp DNS resolution: {flow}")
                                self._host_fw.flow_set_policy(firewall.FlowType.FILTER_OUTPUT, flow, firewall.Policy.ALLOW)
                                allowed_dns_flows.append(flow)
                            except Exception as e:
                                syslog.syslog(syslog.LOG_ERR, f"Could not allow outboud DNS flow '{flow}': {str(e)}")

                    # let all the traffic shapers adapt to the new settings
                    for tshaper in self._traffic_shapers:
                        if not tshaper.functionnal:
                            try:
                                syslog.syslog(syslog.LOG_INFO, f"Adapting traffic shapers: adapt traffic shaper {tshaper.name}")
                                await tshaper.adapt(len(self._dns_resolvers)>0, self._host_fw)
                            except Exception as e:
                                syslog.syslog(syslog.LOG_ERR, f"Traffic shaper '{tshaper}' failed to adapt: {str(e)}")

                    # de-allow temporary DNS resolution
                    for flow in allowed_dns_flows:
                        try:
                            syslog.syslog(syslog.LOG_INFO, f"Adapting traffic shapers: remove tmp DNS resolution: {flow}")
                            self._host_fw.flow_delete_policy(firewall.FlowType.FILTER_OUTPUT, flow)
                        except Exception as e:
                            syslog.syslog(syslog.LOG_ERR, f"Could not block outboud DNS flow '{flow}': {str(e)}")
                syslog.syslog(syslog.LOG_INFO, "Adapting traffic shapers: done")
            except asyncio.exceptions.CancelledError:
                break

    async def _watch_network_changes(self):
        """Task to watch for any DNS change (monitoring the /etc/resolv.conf file)
        """
        watcher=aionotify.Watcher()
        watcher.watch(path="/etc", flags=aionotify.Flags.CREATE | aionotify.Flags.MODIFY | aionotify.Flags.MOVED_TO | aionotify.Flags.DELETE)

        loop=asyncio.get_event_loop()
        await watcher.setup(loop)

        late_func=padsi.misc.LateFunction(self._tsp_event.set)
        while True:
            try:
                event=await watcher.get_event()
                if event is None:
                    syslog.syslog(syslog.LOG_ERR, "CODEBUG: watcher.get_event() returned None")
                elif event.name=="resolv.conf":
                    late_func.start(1)
            except asyncio.exceptions.IncompleteReadError:
                break
        try:
            watcher.close()
        except Exception:
            pass

    async def _tsp_adapt_timer(self) -> None:
        while True:
            try:
                await asyncio.sleep(30)
                self._tsp_event.set()
            except asyncio.exceptions.CancelledError:
                break


    def _setup_fw_rules(self):
        """Set PADSI's rules using objects which name is prefixed by "padsi_" in the netfilter firewall
        """
        fw=self._host_fw

        # deny input and output by default except related connections
        for family in (firewall.Family.IPv4, firewall.Family.IPv6):
            fw.flush(firewall.FlowType.FILTER_OUTPUT, family=family)
            fw.set_default_policy(firewall.FlowType.FILTER_OUTPUT, firewall.Policy.DENY, family=family)
            fw.set_related_connections_policy(firewall.FlowType.FILTER_OUTPUT, firewall.Policy.ALLOW, family=family)

            fw.flush(firewall.FlowType.FILTER_INPUT, family=family)
            fw.set_default_policy(firewall.FlowType.FILTER_INPUT, firewall.Policy.DENY, family=family)
            fw.set_related_connections_policy(firewall.FlowType.FILTER_INPUT, firewall.Policy.ALLOW, family=family)

        # block IPv6 forward
        fw.set_default_policy(firewall.FlowType.FILTER_FORWARD, firewall.Policy.DENY, family=firewall.Family.IPv6)

        # allow DHCP
        flow=firewall.NetFlow.from_repr("* ^ 68 > udp > 255.255.255.255 ^ 67")
        fw.flow_set_policy(firewall.FlowType.FILTER_OUTPUT, flow, firewall.Policy.ALLOW)
        flow=firewall.NetFlow.from_repr("* ^ 67 > udp > * ^68")
        fw.flow_set_policy(firewall.FlowType.FILTER_INPUT, flow, firewall.Policy.ALLOW)

        # silently drop any packet to non routable multicast addressed (autoconfig/autodiscovery is dangerous)
        flow=firewall.NetFlow.from_repr("* > > 224.0.0.0/4")
        fw.flow_set_policy(firewall.FlowType.FILTER_OUTPUT, flow, firewall.Policy.DENY, log_if_deny=False)
        fw.flow_set_policy(firewall.FlowType.FILTER_INPUT, flow, firewall.Policy.DENY, log_if_deny=False)

        # apply rules defined in the configuration
        if self._gconf.host_inbound_fw_rules is not None:
            for rule in self._gconf.host_inbound_fw_rules:
                flow=firewall.NetFlow(None, rule.endpoint)
                fw.flow_set_policy(firewall.FlowType.FILTER_INPUT, flow, firewall.Policy.ALLOW if rule.action=="allow" else firewall.Policy.DENY)

        if self._gconf.host_outbound_fw_rules is not None:
            for rule in self._gconf.host_outbound_fw_rules:
                flow=firewall.NetFlow(rule.endpoint, None)
                fw.flow_set_policy(firewall.FlowType.FILTER_OUTPUT, flow, firewall.Policy.ALLOW if rule.action=="allow" else firewall.Policy.DENY)

    def _cleanup_fw_rules(self):
        """Remove PADSI's rules which have been set up
        """
        fw=self._host_fw
        for family in (firewall.Family.IPv4, firewall.Family.IPv6):
            for ft in firewall.FlowType:
                try:
                    fw.flush(ft)
                    fw.set_default_policy(ft, firewall.Policy.ALLOW, family=family)
                except Exception as e:
                    syslog.syslog(syslog.LOG_ERR, f"Could not clean up host firewall's flow type '{ft}': {str(e)}")

    #
    # users' sessions management
    #
    def declare_session(self, uid:int, session: UserSession):
        if uid in self._user_sessions:
            raise Exception(f"CODEBUG: user {uid} already has a UserSession")
        self._user_sessions[uid]=session

    def _only_system_sessions(self) -> bool:
        """Tell if the opened sessions are only system sessions (like for the 'padsi' user
        in the context of admin. namespaces)
        """
        for uid in self._user_sessions:
            if uid>=1000:
                return False
        return True

    def user_logged_in_cb(self, uid:int, gid:int, shell_proc:psutil.Process):
        """Function called when a user has logged in
        """
        syslog.syslog(syslog.LOG_DEBUG, f"User {uid=} is logged in")
        if uid not in self._user_sessions:
            if _debug:
                syslog.syslog(syslog.LOG_DEBUG, f"Starting PADSI user service for user {uid} (GNOME Shell {shell_proc.pid})")
            server=UserServer(self._gconf, self._host_fw, self._lock, self._usb_watcher, uid, gid)
            task=asyncio.create_task(server.serve_client([self._userservice_path,
                                     os.path.join(PadsiSystemService.users_run_dir, str(uid)),
                                     self._gconf.config_dir]))
            self.declare_session(uid, UserSession(server=server, task=task))

    def user_logged_out_cb(self, uid:int):
        """Function called when a user has logged in
        """
        syslog.syslog(syslog.LOG_DEBUG, f"User {uid=} logged out")
        session=self._user_sessions.get(uid)
        if session is not None:
            if _debug:
                syslog.syslog(syslog.LOG_DEBUG, f"Stopping user service for user {uid}")
            try:
                session.task.cancel()
            except Exception as e:
                syslog.syslog(syslog.LOG_ERR, f"Stopping user service for user {uid} error: {str(e)})")
            del self._user_sessions[uid]

            # check if this service needs to be restarted
            if self._only_system_sessions():
                self._may_restart()

    async def run(self):
        # set host firewall
        try:
            self._setup_fw_rules()
        except Exception as e:
            syslog.syslog(syslog.LOG_ERR, f"Failed to set up host firewall: {str(e)}")

        # start the USB devices monitor if there is at least one VM configured
        if len(self._gconf.get_vms_for_usage(VMUsage.RUN))>0:
            self._usb_watcher_task=asyncio.create_task(self._usb_watcher.run())

        # set up all traffic shapers
        self._setup_traffic_shapers()

        # tasks to adapt traffic shapers
        task=asyncio.create_task(self._adapt_traffic_shapers())
        self._tsp_tasks=[task]
        self._tsp_event.set()
        task=asyncio.create_task(self._watch_network_changes()) # watch for DNS changes
        self._tsp_tasks.append(task)
        task=asyncio.create_task(self._tsp_adapt_timer()) # simple timer to signal traffic shaper to adapt if necessary
        self._tsp_tasks.append(task)

        # run the UserSessionNotifier
        syslog.syslog(syslog.LOG_DEBUG, "UserSessionNotifier run()")
        await super().run()
        syslog.syslog(syslog.LOG_DEBUG, "UserSessionNotifier terminated")

    async def shutdown(self):
        if _debug:
            syslog.syslog(syslog.LOG_DEBUG, "PadsiSystemService shutdown() started")
        tasks=self._tsp_tasks
        self._tsp_tasks=[]
        for task in tasks:
            task.cancel()

        # close user sessions
        all_tasks=[session.task for session in self._user_sessions.values()]
        for uid in list(self._user_sessions.keys()).copy():
            self.user_logged_out_cb(uid)

        # stop all traffic stapers
        loop=asyncio.get_running_loop()
        for tshaper in self._traffic_shapers:
            try:
                if _debug:
                    syslog.syslog(syslog.LOG_DEBUG, f"Destroying traffic shaper {tshaper.name} (netns {tshaper.net_ns})")
                await loop.run_in_executor(None, tshaper.destroy, self.host_fw)
                if _debug:
                    syslog.syslog(syslog.LOG_DEBUG, f"Finished destroying traffic shaper {tshaper.name} (netns {tshaper.net_ns})")
            except Exception as e:
                syslog.syslog(syslog.LOG_ERR, f"Could not destroy traffic shaper {tshaper.name} (netns {tshaper.net_ns}): {str(e)}")
        self._traffic_shapers=set()

        # leave a clean FW
        self._cleanup_fw_rules()

        # USB devices watcher
        if self._usb_watcher_task is not None:
            self._usb_watcher_task.cancel()

        # wait for the remainig tasks to terminate
        if len(all_tasks)>0:
            if _debug:
                syslog.syslog(syslog.LOG_DEBUG, f"Waiting for the lasts user session tasks to terminate ({len(all_tasks)} sessions)")
            await asyncio.wait(all_tasks, return_when=asyncio.ALL_COMPLETED)

        if _debug:
            syslog.syslog(syslog.LOG_DEBUG, "PadsiSystemService shutdown completed (no more task left)")


def _check_privileges_on_vm_version(gconf:Configuration, vm_id:str, vm_version:VMVersion, uid:int):
    """Check the user has a right to manipulate a VM version
    """
    if vm_version is None:
        raise Exception("None vm_version passed to _check_privileges_on_vm_version()")
    match vm_version.version_type:
        case VMVersionType.BASE:
            _get_vm_conf_for_usage(gconf, vm_id, uid, [VMUsage.UPDATE])
        case VMVersionType.USER:
            _get_vm_conf_for_usage(gconf, vm_id, uid, [VMUsage.RUN])
        case VMVersionType.SNAP:
            _get_vm_conf_for_usage(gconf, vm_id, uid, [VMUsage.RUN])
        case _:
            raise Exception(f"Unhandled VMVersionType {vm_version.version_type}")

def _get_vm_conf_for_usage(gconf:Configuration, vm_id:str, uid:int, usages:list[VMUsage]|None) -> VirtualMachine:
    """Get the VM configuration for the specified usage(s), and check is user is actually allowed that usage
    """
    for usage in VMUsage if usages is None else usages:
        vm_conf=gconf.get_vm(usage, vm_id)
        if vm_conf is not None and vm_conf.is_user_allowed(uid):
            return vm_conf
    if usages is None:
        raise Exception(f"Unknown VM '{vm_id}' or permission denied for user {uid}")
    raise Exception(f"Unknown VM '{vm_id}' or permission denied for user {uid} to {', '.join([u.value for u in usages])}")


async def monitor_proc(proc:subprocess.Popen, context:str):
    killed=False
    while True:
        try:
            await asyncio.sleep(5)
            if proc.poll() is not None:
                syslog.syslog(syslog.LOG_INFO, f"{context} has terminated")
                killed=True
                break
        except asyncio.CancelledError:
            break
    if not killed:
        proc.kill()
    proc.wait()

async def _get_process_attributes(pid:int) -> tuple[bool, int|None]: # True if is PCSCD, and UID of the process
    """Get attributes of the specified process:
    - True if it is the PCSC daemon process (even if the actuel process has terminated)
    - the UID of the user running the process, or None if it has terminated
    """
    try:
        dproc=psutil.Process(pid)
        return (dproc.exe()=="/usr/sbin/pcscd", dproc.uids().real)
    except (psutil.NoSuchProcess, psutil.AccessDenied):
        (_, out, _)=await padsi.misc.asyncio_run(["systemctl", "show", "--property", "MainPID", "--value", "pcscd.service"])
        if out=="0":
            # pcscd unit not active
            return (False, None)
        if int(out)==pid:
            return (True, None)
        return (False, None)

async def killed(event:asyncio.Event):
    syslog.syslog(syslog.LOG_INFO, "SIG* received")
    # when systemd stops the padsi service, it sends the TERM signal to all the processes in the cgroup, let's wait a bit so that
    # processes run to properly shut down are not killed by systemd
    time.sleep(0.5)
    event.set()

async def main(config_dir:str):
    gconf=Configuration(config_dir)
    service=PadsiSystemService(os.path.join(_padsi_install_dir, "bin", "user-service"), gconf)

    # remove the need restart file if any
    need_restart_file=gconf.need_restart_file
    try:
        if os.path.exists(need_restart_file):
            os.remove(need_restart_file)
    except Exception as e:
        syslog.syslog(syslog.LOG_ERR, f"Could not remove the '{need_restart_file}' file: {str(e)}")

    # declare traffic shapers
    for tshaper in gconf.traffic_shapers:
        service.declare_traffic_shaper(tshaper)

    # start desktop entries monitor
    proc_tasks:list[asyncio.Task]=[]
    m_proc=subprocess.Popen([os.path.join(_padsi_install_dir, "bin", "monitor-desktop-entries"), config_dir, "GLOBAL"])
    a_task=asyncio.create_task(monitor_proc(m_proc, "Desktop entries monitor"))
    proc_tasks.append(a_task)

    # start data guard (eBPF filter to /run/padsi/user)
    cenv=os.environ.copy()
    cenv["LOG_DIR"]=gconf.logs_dir
    m_proc=subprocess.Popen([os.path.join(_padsi_install_dir, "bin", "data-access-guard")], env=cenv)
    a_task=asyncio.create_task(monitor_proc(m_proc, "Data access guard"))
    proc_tasks.append(a_task)

    # start FW logs collection if needed
    if gconf.firewall_logs_group is not None:
        cenv=os.environ.copy()
        cenv["LOG_GROUP"]=str(gconf.firewall_logs_group)
        cenv["LOG_DIR"]=gconf.logs_dir
        m_proc=subprocess.Popen([os.path.join(_padsi_install_dir, "bin", "fw-logger")], env=cenv)
        a_task=asyncio.create_task(monitor_proc(m_proc, "FW logs"))
        proc_tasks.append(a_task)

    admin_service_task:asyncio.Task|None=None

    # start admin NS if any defined
    if len(gconf.admin_ns_list)>0:
        try:
            padsi_user=pwd.getpwnam("padsi")
        except KeyError:
            raise Exception("Unable to find the 'padsi' user")

        run_dir="/run/padsi/padsi"
        logs_dir=os.path.join(gconf.logs_dir, "padsi")
        for dir in (run_dir, logs_dir):
            os.makedirs(dir, mode=0o700, exist_ok=True)
            os.chown(dir, padsi_user.pw_uid, padsi_user.pw_gid)

        config_data:dict={
            "config-dir":gconf.config_dir,
            "run-dir": run_dir,
            "logs-dir": logs_dir
        }

        config_file=tempfile.NamedTemporaryFile("wt")
        os.chown(config_file.name, padsi_user.pw_uid, padsi_user.pw_gid)
        json.dump(config_data, config_file)
        config_file.flush()

        server=UserServer(gconf, service.host_fw, service.lock, None, padsi_user.pw_uid, padsi_user.pw_gid)
        admin_service_task=asyncio.create_task(server.serve_client([
            os.path.join(_padsi_install_dir, "bin", "admin-service"),
            config_file.name
        ]))
        while True:
            await asyncio.sleep(0.1)
            if admin_service_task.done():
                e=admin_service_task.exception()
                raise Exception(f"Could not start the admin-service: {str(e) if e is not None else 'CODEBUG'}")
            if server.is_running:
                break
        syslog.syslog(syslog.LOG_DEBUG, f"admin-service config file: {config_file.name}")
        service.declare_session(padsi_user.pw_uid, UserSession(server=server, task=admin_service_task))

    # run!
    run_task=None
    try:
        run_task=asyncio.create_task(service.run())
        # catch TERM and INT signals to properly shut down
        kill_event=asyncio.Event()
        loop=asyncio.get_event_loop()
        for s in [signal.SIGTERM, signal.SIGINT]:
            loop.add_signal_handler(s, lambda s=s:asyncio.create_task(killed(kill_event)))
        if _debug:
            syslog.syslog(syslog.LOG_DEBUG, "Waiting for killed asyncio.Event to be set")
        await kill_event.wait()
    finally:
        if _debug:
            syslog.syslog(syslog.LOG_DEBUG, "Got killed event, shutting down")
        if admin_service_task is not None:
            admin_service_task.cancel()
            admin_service_task.done()

        for task in proc_tasks:
            task.cancel()
        proc_tasks=[]

        if run_task is not None:
            run_task.cancel()
        if _debug:
            syslog.syslog(syslog.LOG_DEBUG, "waiting for service.shutdown() to terminate")
        await service.shutdown()
        syslog.syslog(syslog.LOG_INFO, "service.shutdown() terminated")

def _set_sysconf(path:str, value:str) -> str|None:
    """Set a sysconf item and returns the previous value if different from the specified one
    """
    to_change=False
    current_value:str|None=None
    with open(path, "r") as fd:
        current_value=fd.readline().strip()
        if current_value!=value:
            to_change=True
    if to_change:
        with open(path, "wt") as fd:
            fd.write(f"{value}\n")
    return current_value

if __name__=="__main__":
    def usage():
        msg=f"{sys.argv[0]} <configuration directory>"
        syslog.syslog(syslog.LOG_ERR, msg)
        print(msg)
        sys.exit(1)
    if len(sys.argv)!=2:
        usage()

    # set sysconf keys
    current_ip_forward=_set_sysconf("/proc/sys/net/ipv4/ip_forward", "1")
    current_nf_log_all_netns=_set_sysconf("/proc/sys/net/netfilter/nf_log_all_netns", "1")
    try:
        config_dir=sys.argv[1]
        if not os.path.isdir(config_dir):
            print(f"PADSI configuration directory '{config_dir}' does not extist", file=sys.stderr)
            sys.exit(1)

        syslog.syslog(syslog.LOG_INFO, f"Service starting using configuration in '{config_dir}'")
        asyncio.run(main(config_dir))
    finally:
        # revert to previous sysconf settings
        if current_ip_forward is not None and current_ip_forward!="1":
            _set_sysconf("/proc/sys/net/ipv4/ip_forward", current_ip_forward)
        if current_nf_log_all_netns is not None and current_nf_log_all_netns!="1":
            _set_sysconf("/proc/sys/net/netfilter/nf_log_all_netns", current_nf_log_all_netns)

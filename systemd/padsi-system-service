    async def _usb_device_state(self, args:dict) -> Message:
        if self._usb_devices_watcher is None:
            raise Exception("CODEBUG: self._usb_devices_watcher should not be None")
        states=self._usb_devices_watcher.get_devices_states(args["devices"])
        data={}
        for (dev_id, dev_data) in states.items():
            data[dev_id]={
                "used-by": dev_data if isinstance(dev_data, list) else None,
                "reserved-by": dev_data if isinstance(dev_data, int) else None
            }
        return Message(MessageType.REPLY, data)


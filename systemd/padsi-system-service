class UserServer(Server):
    """User service for a specific user
    """
    def __init__(self, gconf:Configuration, host_fw: firewall.Firewall, lock:asyncio.Lock, usb_devices_watcher:USBDevicesMonitor|None, uid: int, gid:int):
        super().__init__(lock)
        self._gconf=gconf
        self._host_fw=host_fw
        self._usb_devices_watcher=usb_devices_watcher
        self._uid=uid
        self._gid=gid

        self._real_uid:int|None=None
        self._real_gid:int|None=None

    def pre_client_spawn(self):
        """Function called before spawning the process, assuming the identify of the user for which a
        the user service process is spawned
        """
        if os.geteuid()!=self._uid:
            # run the process with specific EUID
            self._real_uid=os.geteuid()
            self._real_gid=os.getgid()
            syslog.syslog(syslog.LOG_DEBUG, f"Changing user {self._real_uid} --> {self._uid}")
            os.setegid(self._gid)
            os.seteuid(self._uid)

    def post_client_spawn(self):
        """Function called after spawning the process, reverting to the effective user
        """
        if self._real_gid is not None:
            if self._real_uid is None or self._real_gid is None:
                syslog.syslog(syslog.LOG_ERR, f"CODEBUG: self._real_gid ({self._real_uid}) is None or self._real_gid ({self._real_gid}) is None")
            else:
                syslog.syslog(syslog.LOG_DEBUG, f"Reverting user {self._uid} --> {self._real_uid}")
                os.setegid(self._real_gid)
                os.seteuid(self._real_uid)

    async def handle_request(self, request:Message) -> Message:
        """Actually handle requests from the user service component
        """
        try:
            cmde=request.data["cmde"]
        except Exception:
            raise Exception(f"Invalid request '{request.data}'")

        match cmde:
            case "create-user-dirs":
                # users don't have direct access to their HOME in the various zones
                dirname=self._gconf.all_users_zone_home_dir
                os.makedirs(dirname, exist_ok=True)
                os.chmod(dirname, 0o700)

                for dirname in (
                    self._gconf.get_user_logs_dir(self._uid),
                    self._gconf.get_user_run_dir(self._uid),
                    self._gconf.get_zone_user_home_dir(self._uid)
                ):
                    os.makedirs(dirname, exist_ok=True)
                    os.chown(dirname, self._uid, self._gid)
                    os.chmod(dirname, 0o700)
            case "update-zones-infos-files":
                await self._update_zones_infos_files(request.data)
            case "clean-user-runtime-dir":
                await self._clean_user_runtime_dir()
            case "fuse-cleanup":
                await self._fuse_cleanup(request.data)
            case "zone-userfiles-setup":
                return await self._zone_userfiles_setup(request.data)
            case "zone-userfiles-cleanup":
                await self._zone_userfiles_cleanup(request.data)
            case "vm-management-files-setup":
                await self._vm_management_priv(True, request.data)
            case "vm-management-files-cleanup":
                await self._vm_management_priv(False, request.data)
            case "infra-setup":
                await self._infra_setup(request.data)
            case "infra-cleanup":
                await self._infra_cleanup(request.data)
            case "infra-attach-zone-apps":
                await self._infra_attach_zone_apps(request.data)
            case "infra-create-attach-ns":
                await self._infra_create_attach_ns(request.data)
            case "infra-dnat-incoming":
                await self._infra_dnat_incoming(request.data)
            case "infra-delete-ns":
                await self._infra_delete_ns(request.data)
            case "zone-apps-prepare-dirs":
                await self._zone_apps_prepare_dirs(request.data)
            case "vm-zone-setup":
                await self._vm_zone_setup(request.data)
            case "vm-files-analyse":
                return await self._vm_files_analyse(request.data)
            case "vm-files-list":
                return await self._vm_files_list(request.data)
            case "vm-create-common-dirs":
                await self._vm_create_common_dirs(request.data)
            case "vm-create-stage-dir":
                await self._vm_create_stage_dir(request.data)
            case "vm-commit":
                await self._vm_commit(request.data)
            case "vm-publish":
                return await self._vm_publish(request.data)
            case "vm-cleanup":
                return await self._vm_cleanup(request.data)
            case "vm-discard-files":
                return await self._vm_discard_files(request.data)
            case "vm-load":
                return await self._vm_load(request.data)
            case "vm-launcher":
                return await self._vm_launcher(request.data)
            case "access-pcscd":
                await self._pcscd_access(request.data)
            case "access-usbredir":
                await self._usbredir_access(request.data)
            case "usb-device-state":
                return await self._usb_device_state(request.data)
            case "usb-device-reserve":
                await self._usb_device_reserve(request.data)
            case _:
                raise Exception(f"Unhandled '{cmde}' command")
        return Message(MessageType.REPLY, None)


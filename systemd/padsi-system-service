    async def _vm_cleanup(self, args:dict) -> Message:
        vm_id=args["vm-id"]
        vm_conf=self._gconf.get_vm(VMUsage.UPDATE, vm_id)
        if vm_conf is None:
            raise Exception(f"No declared virtual machine with '{vm_id}' ID")
        loop=asyncio.get_event_loop()
        avmf=await loop.run_in_executor(None, self._compute_avmf, vm_conf.directory, self._uid)
        if isinstance(avmf, Exception):
            raise avmf

        res:list[str]=[]
        for vmversion in avmf.obsolete_versions:
            try:
                _check_privileges_on_vm_version(self._gconf, vm_id, vmversion, self._uid)
            except Exception:
                pass
            else:
                if vmversion.state!=VMState.RUNNING: # just in case
                    syslog.syslog(syslog.LOG_INFO, f"Discarding files of VM version '{vmversion.id}'")
                    vmversion.discard_files()
                    res.append(vmversion.id)
        return Message(MessageType.REPLY, res)

    async def _vm_discard_files(self, args:dict) -> Message:
        vmversion_uid=args["vmversion-uid"]
        vm_id=args["vm-id"]
        vtype=VMVersionType(args["vtype"])
        vnum=args["vnum"]
        staged=args["staged"]
        nickname=args["nickname"]
        force=args.get("force", False)
        vm_conf=_get_vm_conf_for_usage(self._gconf, vm_id, self._uid, None)
        vm_upd_conf=self._gconf.get_vm(VMUsage.UPDATE, vm_id)
        if vm_upd_conf is None:
            raise Exception(f"No declared virtual machine with '{vm_id}' ID")
        if vmversion_uid is not None and vmversion_uid!=self._uid and not vm_upd_conf.is_user_allowed(self._uid):
            raise Exception(f"Permission denied for user {self._uid} on VM '{vm_id}'")

        loop=asyncio.get_event_loop()
        avmf=await loop.run_in_executor(None, self._compute_avmf, vm_conf.directory, self._uid)
        if isinstance(avmf, Exception):
            raise avmf

        if staged:
            vmversion=avmf.get_staged(VMVersionType.BASE, vmversion_uid)
            if vmversion is None:
                raise Exception("No staging version for this VM")
        else:
            if vtype==VMVersionType.BASE:
                vm_conf=_get_vm_conf_for_usage(self._gconf, vm_id, self._uid, [VMUsage.INSTALL, VMUsage.UPDATE])
            else:
                vm_conf=self._gconf.get_vm(VMUsage.RUN, vm_id)
                if vm_conf is None:
                    raise Exception(f"no declared virtual machine with '{vm_id}' ID")

            match vtype:
                case VMVersionType.BASE:
                    vmversion=avmf.get_base_version(vnum)
                case VMVersionType.USER:
                    vmversion=avmf.get_user_version(vnum, vmversion_uid)
                case VMVersionType.SNAP:
                    if nickname is None:
                        vmversion=avmf.get_snapshot_version(vnum, vmversion_uid)
                    else:
                        vmversion=avmf.get_named_snapshot_version(nickname, vmversion_uid)
                case _:
                    raise Exception(f"Unhandled VMVersionType {vtype}")
            if vmversion is None:
                raise Exception("VM version not found")

        if vmversion.state==VMState.RUNNING:
            raise Exception("VM version is running")
        if not force:
            if vmversion.version_type==VMVersionType.BASE and not staged and vmversion not in avmf.obsolete_versions and \
            vmversion.state==VMState.STOPPED:
                raise Exception("VM version is in the latest version")
        if len(avmf.get_children_versions(vmversion))>0:
            raise Exception("VM version is used by other VM versions")

        _check_privileges_on_vm_version(self._gconf, vm_id, vmversion, self._uid)
        syslog.syslog(syslog.LOG_INFO, f"Discarding files of VM version '{vmversion.id}'")
        res=await loop.run_in_executor(None, vmversion.discard_files)
        if isinstance(res, Exception):
            raise res
        return Message(MessageType.REPLY, [vmversion.id])

    async def _vm_load(self, args:dict) -> Message:
        extract_dir=None
        try:
            vm_id=args["vm-id"]
            extract_id=args["extract-id"]
            message=args["message"]

            vm_conf=self._gconf.get_vm(VMUsage.UPDATE, vm_id)
            if vm_conf is None:
                raise Exception(f"No declared virtual machine with '{vm_id}' ID")
            if not vm_conf.is_user_allowed(self._uid):
                raise Exception(f"Permission denied for user {self._uid} on VM '{vm_id}'")

            loop=asyncio.get_event_loop()
            vm_files=await loop.run_in_executor(None, VMFiles, vm_conf.directory, self._uid, self._gid)
            if isinstance(vm_files, Exception):
                raise vm_files

            extract_dir=os.path.join(vm_files.staging_directory, extract_id)
            vm_versions_to_import:dict[int,VMVersion]={}
            dep_vm_expected=False
            dep_vm_version:VMVersion|None=None
            try:
                # VM versions to load
                for fname in os.listdir(extract_dir):
                    if fname.startswith("vm-version-"):
                        vid=int(fname[11:])
                        if vid<0:
                            raise Exception()
                        vm_versions_to_import[vid]=VMVersion.from_files(
                            os.path.join(extract_dir, fname, "base.img"),
                            os.path.join(extract_dir, fname, "base.vars"),
                            os.path.join(extract_dir, fname, "base.infos")
                        )

                # manifest
                with open(os.path.join(extract_dir, "manifest.json"), "r") as fd:
                    manifest=json.load(fd)
                    dep_size=manifest.get("dependency-size")
                    dep_hash=manifest.get("dependency-hash")
                    if dep_size is None and dep_hash is not None or dep_size is not None and dep_hash is None:
                        raise Exception()
                    if dep_size is not None:
                        dep_vm_expected=True
                        for vm_v in vm_files.base_versions:
                            if os.stat(vm_v.image_file).st_size==dep_size:
                                with open(vm_v.image_file, "rb") as fd:
                                    syslog.syslog(syslog.LOG_DEBUG, f"Computing hash of {vm_v.image_file}")
                                    hash=await loop.run_in_executor(None, hashlib.file_digest, fd, "sha256")
                                    if hash.hexdigest()==dep_hash:
                                        dep_vm_version=vm_v
                                        break
            except Exception as e:
                syslog.syslog(syslog.LOG_ERR, f"Invalid saved VM versions' files structure or contents: {str(e)}")
                raise Exception("Invalid saved VM versions' files structure or contents")

            # check global coherence
            vm_versions_ids=sorted(vm_versions_to_import.keys(), reverse=True)
            syslog.syslog(syslog.LOG_DEBUG, f"VM versions to import: {vm_versions_to_import}, sorted IDs: {vm_versions_ids}")
            if dep_vm_expected and dep_vm_version is None:
                raise Exception("Could not idenfy dependency VM version in this instance of PADSI")
            elif not dep_vm_expected:
                # check 1st VM version to import is complete
                vm_version=vm_versions_to_import[vm_versions_ids[0]]
                if not vm_version.is_complete:
                    raise Exception("First VM version to import is not complete")

            # import VM versions one at a time
            res:list[str]=[]
            first_vm=True
            for vid in vm_versions_ids:
                vm_version=vm_versions_to_import[vid]
                e_vm_version=vm_files.get_vm_version_matching_image(vm_version.image_file)
                if e_vm_version is not None:
                    syslog.syslog(syslog.LOG_INFO, f"Loading: extracted's {vm_version} is already present as {e_vm_version}")
                    dep_vm_version=e_vm_version
                else:
                    # "target" VM version
                    tvm_version=VMVersion(VMVersionType.BASE, vm_files.directory, vm_files.next_base_version_number)
                    handled:bool=False
                    if first_vm:
                        first_vm=False
                        if dep_vm_version is None:
                            syslog.syslog(syslog.LOG_DEBUG, f"Loading: handling first VM version: move extracted's {vm_version} to {tvm_version}")
                            vm_version.move(tvm_version, message=message)
                            handled=True

                    if not handled and dep_vm_version is not None:
                        syslog.syslog(syslog.LOG_DEBUG, f"Loading: change backing of extracted's {vm_version} to {dep_vm_version}")
                        vm_version.change_backing_version(dep_vm_version)
                        syslog.syslog(syslog.LOG_DEBUG, f"Loading: move extracted's {vm_version} to {tvm_version}")
                        vm_version.move(tvm_version, message=message)
                    res.append(tvm_version.id)
                    dep_vm_version=tvm_version

                    # change ownership to root
                    for fname in (tvm_version.image_file, tvm_version.vars_file, tvm_version.infos_file):
                        os.chown(fname, 0, 0)

                    vm_files=await loop.run_in_executor(None, VMFiles, vm_conf.directory, self._uid, self._gid)
                    if isinstance(vm_files, Exception):
                        raise vm_files

            return Message(MessageType.REPLY, res)
        finally:
            if extract_dir is not None:
                try:
                    shutil.rmtree(extract_dir)
                except Exception:
                    pass

    async def _vm_launcher(self, args:dict) -> Message:
        def determine_vm_icon_file(top_dir:str, vm_conf:VirtualMachine) -> str:
            base_icon_path=os.path.join(top_dir, "vm-management", "viewer", "icons")
            icon_path=None
            if vm_conf.os_variant is not None:
                if vm_conf.os_version is not None:
                    (v,*_)=vm_conf.os_version.split("/")
                    path=os.path.join(base_icon_path, f"{vm_conf.os_variant}_{v}.png")
                else:
                    path=os.path.join(base_icon_path, f"{vm_conf.os_variant}.png")
                if os.path.exists(path):
                    icon_path=path
            if icon_path is None:
                icon_path=os.path.join(base_icon_path, "generic.png")
            return icon_path

        def compute_de_path(uid:int, gid:int, conf:Configuration, vm_id:str, zone_name:str, nickname:str|None=None) -> str:
            # create the directory where DE files are stored
            path=conf.get_zone_user_home_dir(uid, zone_name)
            de_path=os.path.join(path, ".local", "share", "applications")
            padsi.misc.makedirs_with_owner(de_path, path, uid, gid)
            de_name=f"padsi-vm-viewer.{vm_id}.{nickname if nickname is not None else 'default'}.desktop"
            return os.path.join(de_path, de_name)

        action=args["action"]
        zone_name=args["zone"]
        vm_id=args["vm-id"]
        nickname=args["nickname"]

        match action:
            case "create":
                zone_conf=self._gconf.get_zone(zone_name)
                vm_conf=zone_conf.get_virtual_machine(vm_id)
                if vm_conf is None:
                    raise Exception(f"VM {vm_id} is not allowed in the '{zone_name}' zone")
                if not vm_conf.is_user_allowed(self._uid):
                    raise Exception(f"Permission denied for user {self._uid} on VM '{vm_id}'")

                template=os.path.join(_padsi_install_dir, "padsi", "VMViewer.desktop.templ")
                if not os.path.exists(template):
                    raise Exception(f"Template file '{template}' is missing")

                if nickname in (None, "default"):
                    if vm_conf.os_version is None:
                        name=f"VM {vm_conf.os_variant}"
                    else:
                        name=f"VM {vm_conf.os_variant} {vm_conf.os_version}"
                else:
                    if vm_conf.os_version is None:
                        name=f"VM {vm_conf.os_variant} ({nickname})"
                    else:
                        name=f"VM {vm_conf.os_variant} {vm_conf.os_version} ({nickname})"
                variables={
                    "name": name,
                    "genericname": "Virtual machine",
                    "comments": vm_conf.description,
                    "nickname": nickname if nickname is not None else "default",
                    "icon": determine_vm_icon_file(_padsi_install_dir, vm_conf),
                    "cli": "/usr/bin/padsi-cli",
                    "zone": zone_name,
                    "vmid": vm_id
                }

                with open(template, "rt") as fd:
                    tmp=tempfile.NamedTemporaryFile("wt")
                    for line in fd.readlines():
                        nline=padsi.misc.expand_variables_in_string(line, variables)
                        tmp.write(nline)
                    tmp.flush()

                    de_path=compute_de_path(self._uid, self._gid, self._gconf, vm_id, zone_name, nickname)
                    os.chown(tmp.name, self._uid, self._gid)
                    os.chmod(tmp.name, 0o644)
                    shutil.copyfile(tmp.name, de_path)
                    syslog.syslog(syslog.LOG_INFO, f"Created VM desktop entry {de_path}")
            case "delete":
                de_path=compute_de_path(self._uid, self._gid, self._gconf, vm_id, zone_name, nickname)
                try:
                    os.remove(de_path)
                    syslog.syslog(syslog.LOG_INFO, f"Deleted VM desktop entry {de_path}")
                except FileNotFoundError:
                    pass
                except Exception as e:
                    syslog.syslog(syslog.LOG_INFO, f"Failed to delete VM desktop entry {de_path}: {str(e)}")
            case _:
                raise Exception(f"Unknown vm-launcher action '{action}'")
        return Message(MessageType.REPLY, None)

    async def _pcscd_access(self, args:dict):
        """Grant or revoke access to the PCSCD daemon"""
        grant=args["action"]=="grant"
        polkit_rules_file=os.path.join("/etc/polkit-1/rules.d", f"00-padsi-pcscd-{self._uid}.rules")
        if grant:
            tmpl="""polkit.addRule(function(action, subject) {{
                if ((action.id=="org.debian.pcsc-lite.access_pcsc" || action.id=="org.debian.pcsc-lite.access_card") && subject.user=="{name}") {{
                    return polkit.Result.YES;
                }}
            }});
            """
            name=pwd.getpwuid(self._uid).pw_name
            with open(polkit_rules_file, "wt") as fd:
                fd.write(tmpl.format(name=name))
                fd.close()
        else:
            try:
                os.remove(polkit_rules_file)
            except FileNotFoundError:
                pass


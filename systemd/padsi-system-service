    async def _vm_files_analyse(self, args:dict) -> Message:
        def _vm_versions_list_to_str_list(vmversions:list[VMVersion]) -> list[str]:
            return [str(x) for x in vmversions]
        def _base_staged_to_str(vmversion:VMVersion|None) -> str|None:
            if vmversion is None:
                return None
            if vmversion.is_complete:
                state=vmversion.state
                return state.value if state else "unknown state"
            else:
                return None
        async def _format_status(uid:int, vm:VirtualMachine, avmf:AdminVMFiles, verbose:bool, zone_name:str|None):
            other_vm_versions:dict={}
            if vm.is_user_allowed(uid):
                for ouid in avmf.users:
                    if ouid!=uid:
                        staged=avmf.get_staged(VMVersionType.BASE, ouid)
                        other_vm_versions[ouid]={
                            "base-staged": _base_staged_to_str(staged),
                            "user-versions": _vm_versions_list_to_str_list(avmf.user_versions(ouid)),
                            "snapshot-versions": _vm_versions_list_to_str_list(avmf.snapshot_versions(ouid))
                        }

            infos={}
            for vmversion in avmf.all_versions:
                info:VMVersionInfo=avmf.get_version_info(vmversion)
                state=vmversion.state
                qemu_pid=vmversion.get_qemu_pid()
                if qemu_pid is None:
                    qemu_ns=None
                else:
                    qemu_ns=f"{padsi.misc.get_mnt_namespace(qemu_pid)}{padsi.misc.get_net_namespace(qemu_pid)}"
                if zone_name is None or vmversion.zone_name is None or zone_name==vmversion.zone_name:
                    infos[str(vmversion)]={
                        "dependencies": info.dependencies,
                        "parent": str(info.parent) if info.parent is not None else None,
                        "children": [str(v) for v in info.children],
                        "state": None if state is None else state.value,
                        "qemu-pid": qemu_pid,
                        "qemu-ns": qemu_ns,
                        "zone": vmversion.zone_name,
                        "nickname": vmversion.nickname,
                        "history": [str(event) for event in vmversion.get_history(avmf.get_parent_version(vmversion))] if verbose else []
                    }

            return {
                "vm-id": vm_id,
                "directory-exists": True,
                "base-vm-versions": _vm_versions_list_to_str_list(avmf.base_versions),
                "self-vm-versions": {
                    "base-staged": _base_staged_to_str(avmf.get_staged(VMVersionType.BASE, uid)),
                    "user-versions": _vm_versions_list_to_str_list(avmf.user_versions(uid)),
                    "snapshot-versions": _vm_versions_list_to_str_list(avmf.snapshot_versions(uid))
                },
                "other-vm-versions": other_vm_versions,
                "commitable-vm-versions": _vm_versions_list_to_str_list(avmf.committable_versions),
                "obsolete-vm-versions": _vm_versions_list_to_str_list(avmf.obsolete_versions),
                "unused-files": list(avmf.unused_files),
                "vm-versions-infos": infos
            }

        vm_id=args["vm-id"]
        verbose=args["verbose"]
        zone_name=args.get("zone")
        vm:VirtualMachine|None=None
        for usage in VMUsage:
            vm_conf=self._gconf.get_vm(usage, vm_id)
            if vm_conf is not None and vm_conf.is_user_allowed(self._uid):
                vm=vm_conf
                break
        if vm is None:
            raise Exception(f"Unknown virtual machine '{vm_id}' or not enough privileges")

        loop=asyncio.get_event_loop()
        res=await loop.run_in_executor(None, self._compute_avmf, vm.directory, self._uid)
        if isinstance(res, Exception):
            raise res
        return Message(MessageType.REPLY, await _format_status(self._uid, vm, res, verbose, zone_name))

    async def _vm_files_list(self, args:dict) -> Message:
        loop=asyncio.get_event_loop()
        res=await loop.run_in_executor(None, AdminVMFiles, args["vm-dir"], self._uid)
        if isinstance(res, Exception):

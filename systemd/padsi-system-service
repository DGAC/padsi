    async def _vm_commit(self, args:dict):
        vmversion_uid=args["vmversion-uid"]
        vm_id=args["vm-id"]
        vm_conf=self._gconf.get_vm(VMUsage.UPDATE, vm_id)
        if vm_conf is None:
            raise Exception(f"No declared virtual machine with '{vm_id}' ID")
        if vmversion_uid is not None and vmversion_uid!=self._uid and not vm_conf.is_user_allowed(self._uid):
            raise Exception(f"User {self._uid} has no admin privilege on VM '{vm_id}'")
        message=args["message"]

        if not vm_conf.is_user_allowed(self._uid):
            raise Exception(f"User {self._uid} is not allowed to update VM '{vm_id}'")

        loop=asyncio.get_event_loop()
        avmf=await loop.run_in_executor(None, self._compute_avmf, vm_conf.directory, self._uid)
        if isinstance(avmf, Exception):
            raise avmf
        vmf=avmf.get_vm_files(vmversion_uid)
        if vmf is None:
            raise Exception(f"No VM files for {vmversion_uid}")
        vmversion=vmf.get_version_by_id(args["vm-version"])
        if vmversion is None:
            raise Exception(f"No VM version '{args['vm-version']}'")

        res=await loop.run_in_executor(None, vmf.commit_version, vmversion, None, 0, 0, message)
        if isinstance(res, Exception):
            raise res

    async def _vm_publish(self, args:dict) -> Message:

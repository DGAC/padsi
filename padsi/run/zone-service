async def main(config_dir:str, zone_name:str, zone_infra_run_dir:str):
    try:
        gconf=padsi.config.Configuration(config_dir)
        zoneservice=PadsiZoneService(gconf, zone_name, zone_infra_run_dir)
        await zoneservice.run()
    except Exception as e:
        syslog.syslog(syslog.LOG_ERR, f"Failed to start: {str(e)}")

if __name__=="__main__":
    def usage():
        msg=f"{sys.argv[0]} <configuration directory> <zone name> <zone infra's run dir> "
        syslog.syslog(syslog.LOG_ERR, msg)
        sys.exit(1)
    if len(sys.argv)!=4:
        usage()

    config_dir=sys.argv[1]
    zone_name=sys.argv[2]
    zone_infra_run_dir=sys.argv[3]
    syslog.syslog(syslog.LOG_INFO, f"Zone name {zone_name}, PID: {os.getpid()}, UID {os.getuid()} in {zone_infra_run_dir}, Using configuration in '{config_dir}'")

    asyncio.run(main(config_dir, zone_name, zone_infra_run_dir))

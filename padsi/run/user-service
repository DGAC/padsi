    async def _vm_run(self, vm_id: str, nickname: str | None, zone_name: str):
        task: Task | None = None
        try:
            # determine VM and zone configs to use
            if not zone_name:
                raise Exception("zone not specified")
            zone_conf: padsi.config.Zone = self._gconf.get_zone(zone_name)
            vm_conf: padsi.config.VirtualMachine | None = zone_conf.get_virtual_machine(vm_id)
            if vm_conf is None:
                raise Exception(f"No declared virtual machine with '{vm_id}' ID (for the '{padsi.config.VMUsage.RUN.value}' usage) in the '{zone_name}' zone")

            # check user has the permission
            vm_conf.check_user_allowed(self._uid)

            # compute VMFiles for the specified VM configuration
            if not os.path.exists(vm_conf.directory):
                raise Exception("Could not find any base version to use")
            loop = asyncio.get_event_loop()
            vm_files = await loop.run_in_executor(None, padsi.run.VMFiles, vm_conf.directory, self._uid, self._gid)

            # generate a nickname if none provided
            if nickname is None:
                while True:
                    nname = namesgenerator.get_random_name()
                    if vm_files.get_named_snapshot_version(zone_name, nname) is None:
                        # nickname not used!
                        break
            elif not padsi.run.VMVersion.nickname_is_valid(nickname):
                raise Exception(f"Invalid nickname '{nickname}'")
            else:
                nname = nickname

            # check request already being handled
            task = Task(
                f"vm_post:{vm_id}:{padsi.config.VMUsage.RUN.value}:{nname}",
                f"Starting VM '{vm_id}' with nickname '{nname}' ('{padsi.config.VMUsage.RUN.value}' usage)",
            )
            await self._mark_task_started(task, ensure_unique=True, unique_descr=f"VM {vm_id} '{nname}' is already being started")
            await vm_proxy.create_vm_dirs(self._call_system_service, vm_id)

            # comply with network requirements
            if zone_conf.network_spec is not None:
                (compat, failed)=vm_conf.is_network_compatible(zone_conf.network_spec, zone_conf.web_proxies)
                if not compat:
                    raise Exception(f"VM network requirements '{failed}' not compatible with zone's networking restrictions")
            await self._prepare_zone_dirs(zone_conf, vm_conf=vm_conf)

            # determine actual VM version to use
            vm_version: padsi.run.VMVersion | None = vm_files.get_named_snapshot_version(zone_name, nname)
            if vm_version is not None and vm_version.state==padsi.run.VMState.DISCARDED:
                # get rid of that VM version
                if _debug:
                    syslog.syslog(syslog.LOG_DEBUG, f"Getting rid of snapshot {vm_version}")
                await self._call_system_service(
                    {
                        "cmde": "vm-discard-files",
                        "zone": zone_name,
                        "vmversion-uid": vm_version.uid,
                        "vm-id": vm_id,
                        "vtype": vm_version.version_type,  # pyright: ignore
                        "vnum": vm_version.version_number,
                        "staged": vm_version.staged,
                        "nickname": nname,
                        "force": False,
                    }
                )
                vm_files = await loop.run_in_executor(None, padsi.run.VMFiles, vm_conf.directory, self._uid, self._gid)
                vm_version=None

            if vm_version is None:
                try:
                    (userid, _vtype, vnum, staged, pnname) = padsi.run.parse_vm_version(nname)
                    if vnum is not None:
                        vm_version = vm_files.get_snapshot_version(vnum, zone_name)
                        if vm_version is None:
                            raise Exception
                        # check we have a correct VM version
                        if (userid is not None and userid != self._uid) or staged \
                            or vm_version.version_type != padsi.run.VMVersionType.SNAP:
                            raise Exception()
                        if pnname is not None:
                            nname = pnname
                except Exception:
                    syslog.syslog(syslog.LOG_WARNING, f"Can't use VM version '{vm_version}'")

            if vm_version is not None:
                # check if VMVersion is already in use
                if self._is_vmversion_used(vm_version):
                    # show the VM viewer
                    self._vm_show_viewer(zone_name, vm_version)
                    await self._mark_task_finished(task)
                    return json_response(None)
                else:
                    task.asyncio_task = asyncio.create_task(self._vm_run_raw(task, zone_conf, vm_conf, vm_version))
                    return json_response(
                        {
                            "vm-id": vm_id,
                            "vm-version": str(vm_version),
                            "vm-nickname": vm_version.nickname,
                            "customization": False,
                            "task": task.descr,
                        }
                    )
            else:
                # start a new snapshot based on the last user VMVersion (creating one if none exist)
                user_vmversion = vm_files.get_last_user_version(zone_name)
                if user_vmversion is None or vm_files.last_user_version_is_obsolete(zone_name):
                    # instanciate a USER VM version, customization will be done elsewhere
                    if vm_files.last_base_version is None:
                        raise Exception("No BASE VM version available")
                    user_vmversion = await loop.run_in_executor(
                        None,
                        vm_files.create_user_version,
                        zone_name,
                        vm_files.last_base_version,
                    )
                    # customize the new user VM version
                    task.asyncio_task = asyncio.create_task(self._vm_customize_and_run(
                            task,
                            zone_conf,
                            vm_conf,
                            vm_version=user_vmversion,
                            vm_files=vm_files,
                            nickname=nname,
                        )
                    )
                    return json_response(
                        {
                            "vm-id": vm_id,
                            "vm-version": str(user_vmversion),
                            "vm-nickname": nname,
                            "customization": True,
                            "task": task.descr,
                        }
                    )
                else:
                    vm_version = vm_files.create_snaphot_version(zone_conf.name, user_vmversion)
                    vm_version.nickname = nname
                    task.asyncio_task = asyncio.create_task(self._vm_run_raw(task, zone_conf, vm_conf, vm_version))
                    return json_response(
                        {
                            "vm-id": vm_id,
                            "vm-version": str(vm_version),
                            "vm-nickname": vm_version.nickname,
                            "customization": False,
                            "task": task.descr,
                        }
                    )
        except Exception as e:
            if task is not None:
                await self._mark_task_finished(task)
            raise e

    async def _vm_install_or_update(self, usage: padsi.config.VMUsage, vm_id: str, zone_name: str|None,
        boot_iso: str | None, extra_isos: list[str] | None, iso_file: str | None):
        task: Task | None = None
        try:
            # determine VM and zone configs to use
            zone_conf: padsi.config.Zone | None = None
            if zone_name is not None:  # may be unspecified by the user, will be determined automatically
                zone_conf = self._gconf.get_zone(zone_name)
            vm_conf: padsi.config.VirtualMachine | None = self._gconf.get_vm(usage, vm_id)
            if vm_conf is None:
                raise Exception(f"No declared virtual machine with '{vm_id}' ID (for the '{usage.value}' usage)")

            # check user has the permission
            vm_conf.check_user_allowed(self._uid)
            await vm_proxy.create_vm_dirs(self._call_system_service, vm_id)

            # compute VMFiles for the specified VM configuration
            loop = asyncio.get_event_loop()
            vm_files = await loop.run_in_executor(None, padsi.run.VMFiles, vm_conf.directory, self._uid, self._gid)

            # check request already being handled
            task = Task(
                f"vm_post:{vm_id}:{usage.value}",
                f"Starting VM '{vm_id}' ('{usage.value}' usage)",
            )
            await self._mark_task_started(task, ensure_unique=True, unique_descr=f"VM {vm_id} is already being {usage.value}")

            # comply with network requirements
            if zone_conf is not None:
                if zone_conf.network_spec is not None:
                    (compat, failed)=vm_conf.is_network_compatible(zone_conf.network_spec, zone_conf.web_proxies)
                    if not compat:
                        raise Exception(f"VM network requirements '{failed}' not compatible with zone's networking restrictions")
                    else:
                        syslog.syslog(syslog.LOG_ERR, f"VM '{vm_id}' ('{usage.value}') will use zone '{zone_name}' networking as specified")
            else:
                for zone_name in self._gconf.get_zones_names():
                    z = self._gconf.get_zone(zone_name)
                    if z.network_spec is not None:
                        (compat, failed)=vm_conf.is_network_compatible(z.network_spec, z.web_proxies)
                        if compat:
                            zone_conf = z
                            syslog.syslog(syslog.LOG_ERR,f"VM '{vm_id}' ('{usage.value}') will use zone '{zone_name}' networking as compatible",)
                            break
                if zone_conf is None:
                    raise Exception("Could not identify a zone which networking restrictions are compatible with VM network requirements for installation")
            zone_name=zone_conf.name
            await self._prepare_zone_dirs(zone_conf, vm_conf=vm_conf)

            # staging directory preparation if necessary
            await self._call_system_service(
                {
                    "cmde": "vm-create-stage-dir",
                    "vm-id": vm_conf.id,
                    "usage": vm_conf.usage.value,
                }
            )

            # determine actual VM version to use
            vm_version: padsi.run.VMVersion | None = None
            if vm_conf.usage == padsi.config.VMUsage.INSTALL:
                # we are installing a new base VM
                vm_version = await loop.run_in_executor(None, vm_files.stage_from_scratch, padsi.run.VMVersionType.BASE,
                    vm_conf.specs.disk_size_mb, vm_conf.specs.secure_boot, self._uid, self._gid)
            elif vm_conf.usage == padsi.config.VMUsage.UPDATE:
                # we are updating a base VM
                base_mvversion = vm_files.last_base_version
                if base_mvversion is None:
                    raise Exception("VM has no base version to update")
                vm_version = await loop.run_in_executor(None, vm_files.stage_existing_version, base_mvversion,
                    self._uid, self._gid)

            assert vm_version is not None
            if self._is_vmversion_used(vm_version):
                # show the VM viewer
                self._vm_show_viewer(zone_name, vm_version)
                await self._mark_task_finished(task)
                return json_response(None)

            # actually run the VM
            task.asyncio_task = asyncio.create_task(self._vm_run_raw(task, zone_conf, vm_conf, vm_version, boot_iso, extra_isos, iso_file))

            return json_response(
                {
                    "vm-id": vm_id,
                    "vm-version": str(vm_version),
                    "vm-nickname": vm_version.nickname,
                    "zone": zone_name,
                    "customization": False,
                    "task": task.descr,
                }
            )
        except Exception as e:
            if task is not None:
                await self._mark_task_finished(task)
            raise e

    async def _api_vm_post(self, request: web.Request):
        """Start a new VM in the specified zone, for any usage (install, update or run),
        actually always instanciate a new ZoneApps, OR import/load a VM from its HDD and VARS files
        """
        # analyse arguments
        try:
            data = await request.json()
            vm_id = padsi.config.strip_vm_id(data.get("vm-id"))
            nickname = data.get("nickname")
            hdd_file="" # safe init value for the linter
            vars_file="" # safe init value for the linter
            message = data.get("message")
            zone_name = data.get("zone")
            if zone_name is not None and not isinstance(zone_name, str):
                raise Exception(f"Invalid zone name '{zone_name}'")
            action=data.get("action")
            match action:
                case "import" | "load":
                    usage = None
                    hdd_file = data.get("hdd-file")
                    vars_file = data.get("vars-file")
                    extract_id = data.get("extract-id")
                case _:
                    usage = padsi.config.VMUsage(action)
                    if usage == padsi.config.VMUsage.RUN and not zone_name:
                        raise Exception("Missing or empty zone name")
                    if nickname is not None and usage != padsi.config.VMUsage.RUN:
                        raise Exception(f"VM usage {usage.value} does not allow specifying a nickname")

            boot_iso = data.get("boot-iso")
            if boot_iso is not None and not isinstance(boot_iso, str):
                raise Exception("Invalid boot ISO file name")
            extra_isos = data.get("extra-isos")
            if extra_isos is not None:
                if isinstance(extra_isos, list):
                    for path in extra_isos:
                        if (
                            path is None
                            or not isinstance(path, str)
                            or not padsi.misc.is_iso_image(path)
                        ):
                            raise Exception(f"Invalid path {path} extra ISOs argument")
                else:
                    raise Exception("Invalid extra ISOs argument")
            iso_file = data.get("extra-iso-file")
            if iso_file is not None and (not isinstance(iso_file, str) or not padsi.misc.is_iso_image(iso_file)):
                raise Exception("Invalid extra ISO file argument")
        except Exception as e:
            return web.Response(text=f"Invalid input ({str(e)})", status=400)

        # do the job
        try:
            match action:
                case "import":
                    return await self._vm_post_import(vm_id, hdd_file, vars_file, message)
                case "load":
                    return await self._vm_post_load(vm_id, extract_id, message) # pyright: ignore
                case _:
                    if usage == padsi.config.VMUsage.RUN:
                        assert(zone_name)
                        return await self._vm_run(vm_id, nickname, zone_name)
                    elif usage in (padsi.config.VMUsage.INSTALL, padsi.config.VMUsage.UPDATE):
                        assert(usage is not None)
                        return await self._vm_install_or_update(usage, vm_id, zone_name, boot_iso, extra_isos, iso_file)
                    else:
                        raise Exception(f"Unnown '{usage}' VM usage")
        except Exception as e:
            if usage is None:
                if data.get("action") == "import":
                    return web.Response(text=f"Could not import the VM: {str(e)}", status=400)
                else:
                    return web.Response(text=f"Could not load the VM: {str(e)}", status=400)
            return web.Response(text=f"Could not start the VM: {str(e)}", status=400)

    async def _api_vm_display(self, request: web.Request):
        """Display the VM viewer for a running VM"""
        try:
            data = await request.json()
            vm_id = padsi.config.strip_vm_id(data.get("vm-id"))
            nickname = data.get("nickname")
            zone_name = data.get("zone")
            if zone_name is not None and not isinstance(zone_name, str):
                raise Exception("Invalid zone name")
        except Exception as e:
            return web.Response(text=f"Invalid input ({str(e)})", status=400)

        try:
            # determine VM and zone configs to use
            if not zone_name:
                raise Exception("zone not specified")
            if not nickname:
                raise Exception("No VM name specified")

            zone_conf: padsi.config.Zone = self._gconf.get_zone(zone_name)
            vm_conf: padsi.config.VirtualMachine | None = zone_conf.get_virtual_machine(vm_id)
            if vm_conf is None:
                raise Exception(f"No declared virtual machine with '{vm_id}' ID (for the '{padsi.config.VMUsage.RUN.value}' usage) in the '{zone_name}' zone")

            # check user has the permission
            vm_conf.check_user_allowed(self._uid)

            # comput VMFiles for the specified VM configuration
            loop = asyncio.get_event_loop()
            vm_files = await loop.run_in_executor(None, padsi.run.VMFiles, vm_conf.directory, self._uid, self._gid)

            # determine actual VM version to use
            vm_version: padsi.run.VMVersion | None = vm_files.get_named_snapshot_version(zone_name, nickname)
            if vm_version is None:
                try:
                    (userid, vtype, vnum, staged, nickname) = padsi.run.parse_vm_version(nickname)
                    if vnum is not None:
                        vm_version = vm_files.get_snapshot_version(vnum, zone_name)
                except Exception:
                    raise Exception(f"Invalid nickname '{nickname}'")

            if vm_version is not None and self._is_vmversion_used(vm_version):
                # show the VM viewer
                self._vm_show_viewer(zone_name, vm_version)
                return json_response(None)
            raise Exception("VM does not exist or is not running")
        except Exception as e:
            return web.Response(text=f"Could not display the VM: ({str(e)})", status=400)

    async def _vm_run_raw(self, task: Task, zone_conf: padsi.config.Zone, vm_conf: padsi.config.VirtualMachine,
        vm_version: padsi.run.VMVersion, boot_iso: str | None = None, extra_isos: list[str] | None = None, iso_file: str | None = None):
        try:
            syslog.syslog(syslog.LOG_INFO, f"Actual VM starting with task {task.id}")
            izone = await self._start_vm_zone(zone_conf, vm_conf, vm_version,
                boot_iso=boot_iso, extra_isos=extra_isos, iso_file=iso_file)
            if izone.api is not None:
                izone.api.auto_stop = True
        except Exception as e:
            syslog.syslog(syslog.LOG_ERR, f"Failed to start VM with task {task.id}: {str(e)}")
        finally:
            await self._mark_task_finished(task)

    async def _vm_customize_and_run(self, task: Task, zone_conf: padsi.config.Zone, vm_conf: padsi.config.VirtualMachine,
        vm_version: padsi.run.VMVersion, vm_files: padsi.run.VMFiles, nickname: str):
        """User VM customization before actually running the VM"""
        cust_task = Task(f"vm_customize:{vm_conf.id}:{vm_version}",
            f"Customizing VM '{vm_conf.id}' for user {self._uid}")
        cust_failed: bool = False
        try:
            waited = await self._mark_task_started(cust_task)
            if not waited:
                syslog.syslog(syslog.LOG_INFO, f"Starting USER VM customization ({vm_version})")
                izone = await self._start_vm_zone(zone_conf, vm_conf, vm_version)
                if izone.api is None:
                    raise Exception("CODEBUG: izone.api should not be None")
                izone.api.auto_stop = True
                await asyncio.sleep(5)
                loop = asyncio.get_running_loop()
                while True:
                    await asyncio.sleep(0.5)
                    if izone.bubble is None:
                        raise Exception("CODEBUG: izone.bubble should not be None")
                    state = await loop.run_in_executor(None, izone.bubble.get_state)
                    if state != nsbubble.BubbleState.RUNNING:
                        syslog.syslog(syslog.LOG_INFO, f"Finished USER VM customization with state {vm_version.state}")
                        if vm_version.state != padsi.run.VMState.STOPPED:
                            raise Exception("USER VM customization has been aborted")
                        break
        except Exception as e:
            cust_failed = True
            syslog.syslog(syslog.LOG_ERR, f"Failed to customize VM with task {task.id}: {str(e)}")
        finally:
            await self._mark_task_finished(cust_task)

        if cust_failed:
            await self._mark_task_finished(task)
        else:
            final_vmversion = vm_files.create_snaphot_version(zone_conf.name, vm_version)
            final_vmversion.nickname = nickname
            await self._vm_run_raw(task, zone_conf, vm_conf, final_vmversion)

    async def _vm_publish(self, task: Task, vm_id: str, userid: int, message: str):

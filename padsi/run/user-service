async def monitor_process(proc: subprocess.Popen, context: str):
    while True:
        try:
            await asyncio.sleep(5)
            if proc.poll() is not None:
                if proc.returncode != -15:
                    # -15 is because process was killed
                    syslog.syslog(syslog.LOG_WARNING, f"{context} process has terminated (status {proc.returncode})")
                elif _debug:
                    syslog.syslog(syslog.LOG_DEBUG, f"{context} process has terminated (status {proc.returncode})")
                proc.wait()
                return
        except asyncio.CancelledError:
            return


async def main(user_session_dir: str, config_dir: str):
    extra: dict[str, list] = {}
    try:
        gconf = padsi.config.Configuration(config_dir)
        userservice = PadsiUserService(user_session_dir, gconf)

        # start desktop entries monitor
        script_file = "???"
        try:
            script_dir = os.path.realpath(os.path.dirname(__file__))
            script_file = os.path.join(script_dir, "monitor-desktop-entries")
            proc = subprocess.Popen([script_file, config_dir, "USER"])
            task = asyncio.create_task(monitor_process(proc, "Desktop entries monitor"))
            extra["DE"] = [proc, task]
        except FileNotFoundError:
            raise Exception(f"Desktop entries monitoring program '{script_file}' is missing")

        # start the Web redirections notifications server if necessary
        notif_server_required = False
        for name in gconf.get_zones_names():
            zone_conf = gconf.get_zone(name)
            if zone_conf.get_option(padsi.config.ZoneOptionType.WEB_REDIRECTION).enabled:
                notif_server_required = True
                break
        if notif_server_required:
            try:
                prog_dir = os.path.join(
                    os.path.dirname(script_dir),
                    "padsi",
                    "run",
                    "components",
                    "web_infra",
                )
                script_file = os.path.join(prog_dir, "notif-server.py")
                proc = subprocess.Popen([script_file, user_session_dir, config_dir])
                task = asyncio.create_task(
                    monitor_process(proc, "Notifications server")
                )
                extra["NOTIF"] = [proc, task]
            except FileNotFoundError:
                raise Exception(f"Notifications server program '{script_file}' is missing")

        # start the netlink shim if necessary
        netlink_shim_required = False
        for name in gconf.get_zones_names():
            zone_conf = gconf.get_zone(name)
            if (
                zone_conf.has_virtual_machines
                or zone_conf.get_option(padsi.config.ZoneOptionType.FIDO2).enabled
            ):
                netlink_shim_required = True
                break
        if netlink_shim_required:
            try:
                script_file = os.path.join(script_dir, "netlink-proxy")
                proc = subprocess.Popen([script_file, user_session_dir])
                task = asyncio.create_task(monitor_process(proc, "Netlink proxy"))
                extra["NETLINK"] = [proc, task]
            except FileNotFoundError:
                raise Exception(f"Netlink proxy program '{script_file}' is missing")

        # run
        await userservice.run()
    except Exception as e:
        syslog.syslog(syslog.LOG_ERR, f"Failed to start: {str(e)}")
    finally:
        for proc_task in extra.values():
            (proc, task) = proc_task
            task.cancel()
            proc.kill()
            proc.wait()


if __name__ == "__main__":
    try:
        if len(sys.argv) != 3:
            raise Exception(f"Usage: {sys.argv[0]} <user session directory> <configuration directory>")

        # drop privileges if necessary
        if os.getuid() != os.geteuid():
            euid = os.geteuid()
            os.seteuid(os.getuid())
            os.setgid(os.getegid())
            os.setuid(euid)

        config_dir = sys.argv[2]
        user_session_dir = sys.argv[1]
        syslog.syslog(syslog.LOG_INFO, f"PID: {os.getpid()}, UID {os.getuid()} in {user_session_dir}, Using configuration in '{config_dir}'")

        asyncio.run(main(user_session_dir, config_dir))
    except Exception as e:
        syslog.syslog(syslog.LOG_ERR, f"Error: {str(e)}")
        print(str(e), file=sys.stderr)
        sys.exit(1)

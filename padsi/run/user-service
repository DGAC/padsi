    #
    # Web redirection
    #
    async def _api_web_redir_get(self, request: web.Request):
        """Identify which zone can be used to open a specific Web site from a specific zone
        identified by the the PID of a process running in it
        """
        try:
            host = request.rel_url.query.get("host")
            if not isinstance(host, str):
                raise Exception(f"Invalid host specification '{host}'")
            port = int(request.rel_url.query.get("port"))  # pyright: ignore
            if port <= 0 or port > 65355:
                raise Exception(f"Invalid port number '{port}'")
            pid = int(request.rel_url.query.get("pid"))  # pyright: ignore
            if pid <= 0:
                raise Exception(f"Invalid PID number '{pid}'")
        except Exception as e:
            return web.Response(text=f"Invalid input ({str(e)})", status=400)

        try:
            # get the zone in which the process is
            zone_conf: padsi.config.Zone | None = None
            async with self._lock:
                for zdata in self._zones.values():
                    try:
                        if zdata.infra is not None and zdata.infra.bubble is not None:
                            if zdata.infra.bubble.is_host_pid_beneath_bubble(pid):
                                zone_conf = zdata.infra.zone_conf
                                if _debug:
                                    syslog.syslog(syslog.LOG_DEBUG, f"Zone for PID {pid} is {zone_conf.name}")
                                break
                    except Exception as e:
                        syslog.syslog(syslog.LOG_WARNING, f"Failed to check if PID {pid} is in a bubble: {str(e)}")

            # get the list of zones to which a web redirection can be done
            allowed_zones: list[str] | None = None
            if zone_conf is not None:
                web_redirection_option = zone_conf.get_option(padsi.config.ZoneOptionType.WEB_REDIRECTION)
                if _debug:
                    syslog.syslog(syslog.LOG_DEBUG, f"Web redirection allowed zones for zone {zone_conf.name}: {web_redirection_option.allowed_zones}")  # pyright: ignore
                if web_redirection_option.enabled:
                    allowed_zones = web_redirection_option.allowed_zones # pyright: ignore

            # get the list of zones which can connect to the requested host and port, filtered by
            # the previous list
            res: list[str] = []  # list of zones where the site is allowed
            if allowed_zones is not None:
                endpoint = firewall.Endpoint.from_repr(f"{host}. ^ tcp ^ {port}")
                for zone_name in allowed_zones:
                    try:
                        zone_conf = self._gconf.get_zone(zone_name)
                    except Exception:
                        syslog.syslog(syslog.LOG_WARNING, f"Zone '{zone_name}' is listed as possible Web redirections zone but does not exist")
                        zone_conf = None

                    if (
                        zone_conf is not None
                        and zone_conf.network_spec is not None
                        and zone_conf.network_spec.resolv_rules is not None
                    ):
                        added = False
                        for rule in zone_conf.network_spec.resolv_rules:
                            if _debug:
                                syslog.syslog(syslog.LOG_DEBUG, f"Testing {endpoint=} vs main network {rule=}",)
                            if rule.action == "allow" and endpoint.is_part_of(rule.endpoint):
                                res.append(zone_name)
                                added = True
                                if _debug:
                                    syslog.syslog(syslog.LOG_DEBUG, f"rule {endpoint} is a subset of {rule.endpoint}")
                                break
                        if not added and len(zone_conf.web_proxies)>0:
                            for proxy in zone_conf.web_proxies:
                                if added:
                                    break
                                if proxy.resolv_rules is not None:
                                    for rule in proxy.resolv_rules:
                                        if _debug:
                                            syslog.syslog(syslog.LOG_DEBUG, f"Testing {endpoint=} vs proxy network {rule=}")
                                        if rule.action == "allow" and endpoint.is_part_of(rule.endpoint):
                                            res.append(zone_name)
                                            if _debug:
                                                syslog.syslog(syslog.LOG_DEBUG, f"rule {endpoint} is a subset of {rule.endpoint}")
                                            added=True
                                            break

            return json_response({"zones": res})
        except Exception as e:
            return web.Response(text=f"Error: ({str(e)})", status=400)

    async def _api_web_redir_post(self, request: web.Request):
        try:
            data = await request.json()
            zone_name = data.get("zone")
            if not zone_name or not isinstance(zone_name, str):
                raise Exception(f"Invalid zone name '{zone_name}'")
            zone_conf = self._gconf.get_zone(zone_name)
            url = data.get("url")
            if url is not None and not isinstance(url, str):
                raise Exception(f"Invalid URL '{url}'")
            browser = data.get("browser")
            if browser is not None and not isinstance(browser, str):
                raise Exception(f"Invalid browser '{browser}'")
            if browser not in padsi.config.ProgramPoliciesFactory().supported_browsers:
                raise Exception(f"Unsupported browser '{browser}'")
        except Exception as e:
            return web.Response(text=f"Invalid input ({str(e)})", status=400)

        try:
            izone = await self._get_zone_apps(zone_conf)
            factory = padsi.config.ProgramPoliciesFactory().get_program_policies(browser)
            args = factory.get_open_url_arguments(url)  # pyright: ignore
            loop = asyncio.get_running_loop()
            pid = await loop.run_in_executor(None, izone.api.start_process, args) # pyright: ignore
            self._set_zone_autostop(izone)
            return json_response({"pid": pid})
        except Exception as e:
            return web.Response(text=f"Could not create VM launcher: ({str(e)})", status=400)

    #
    # USB devices access
    #
    async def _api_usb_device_get(self, request: web.Request):
        """Request the usage status of a USB device"""

        def _uid_to_user_name(uid: int) -> str:
            if uid == self._uid:
                return "-"
            return pwd.getpwuid(uid).pw_gecos.split(",")[0]

        try:
            devices_ids = request.rel_url.query.get("devices")
            if not isinstance(devices_ids, str):
                raise Exception(f"Invalid USB devices IDs list '{devices_ids}'")
            if not devices_ids:  # empty list
                return json_response({})
            devices_ids = devices_ids.split(",")
        except Exception as e:
            return web.Response(text=f"Invalid input ({str(e)})", status=400)

        try:
            # ask the system service
            try:
                data = await self._call_system_service(
                    {"cmde": "usb-device-state", "devices": devices_ids}
                )
                if not isinstance(data, dict):
                    raise Exception("CODEBUG: 'usb-device-state' did not return a dict")
                # data will be like:
                # {
                #     "003:012": {
                #         "used-by": [1000]    <-- list of UIDs or None
                #         "reserved-by": 1001  <-- single UID, or None
                #     }
                # }
                resdata = {}
                for dev_id, dev_data in data.items():
                    resdata[dev_id] = {
                        "used-by": (
                            [_uid_to_user_name(uid) for uid in dev_data["used-by"]]
                            if dev_data["used-by"] is not None
                            else None
                        ),
                        "reserved-by": (
                            _uid_to_user_name(dev_data["reserved-by"])
                            if dev_data["reserved-by"] is not None
                            else None
                        ),
                    }
                return json_response(resdata)
            except Exception as e:
                syslog.syslog(syslog.LOG_ERR, f"Could not get USB devices' status for '{devices_ids}': {str(e)}")
                raise e
        except Exception as e:
            return web.Response(text=f"Could not get USB devices' status for '{devices_ids}': ({str(e)})", status=400)

    async def _api_usb_device_post(self, request: web.Request):
        try:

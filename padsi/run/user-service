    async def _api_vm_modify(self, request: web.Request):
        """Publish a staged VM version or merge a VM version with its backing VM version
        User must be allowed to either install of update the VM
        """
        # analyse arguments
        try:
            data = await request.json()
            action = data.get("action")
            if action not in ("publish", "merge"):
                raise Exception(f"Unknown action '{action}'")
            merge = action == "merge"
            zone_name = data.get("zone")
            message = data.get("message")
            vm_id = padsi.config.strip_vm_id(data.get("vm-id"))
            (userid, vtype, vnum, _staged, _nickname)=\
                padsi.run.parse_vm_version(data.get("vm-version")) if merge \
                else (None, None, None, None, None)
            if userid is None:
                userid = self._uid
        except Exception as e:
            return web.Response(text=f"Invalid input ({str(e)})", status=400)

        # check request already being handled
        try:
            usermsg = f"for user {userid}"
            if merge:
                if vtype is None:
                    raise Exception("Could not determine VM version type")
                task = Task(f"vm_modify:{vm_id}:{merge}:{userid}",
                    f"Merging VM '{vm_id}' {vtype.value}.{vnum} {usermsg}")
            else:
                task = Task(f"vm_modify:{vm_id}:{merge}:{userid}",
                    f"Publishing VM '{vm_id}' {usermsg}")
        except Exception as e:
            return web.Response(text=str(e), status=400)

        # do the job
        try:
            if await self._mark_task_started(task, ensure_unique=True):
                # was already done by another task
                return json_response({"task": None})
            if merge:
                assert(vtype is not None)
                task.asyncio_task = asyncio.create_task(self._vm_merge(task, vm_id, zone_name, userid, vtype, vnum, message))
            else:
                task.asyncio_task = asyncio.create_task(self._vm_publish(task, vm_id, userid, message))
            return json_response({"task": task.descr})
        except Exception as e:
            await self._mark_task_finished(task)
            return web.Response(text=str(e), status=400)

    async def _api_vm_delete(self, request: web.Request):
        """Delete the resources associated to a VM version, or all the obsolete VM versions"""
        # analyse arguments
        try:
            data = await request.json()
            action = data.get("action")
            if action not in ("discard", "clean"):
                raise Exception(f"Unknown action '{action}'")
            cleanup = action == "clean"
            vm_id = padsi.config.strip_vm_id(data.get("vm-id"))
            force = data.get("force", False)
            vm_version=data.get("vm-version")
            zone_name = data.get("zone")
        except Exception as e:
            return web.Response(text=f"Invalid input ({str(e)})", status=400)

        # do the job
        if cleanup:
            try:
                # discard all the obsolete (unused anymore) VM versions
                res = await vm_proxy.vm_cleanup(self._gconf, self._call_system_service, vm_id, zone_name)
                return json_response(res)
            except Exception as e:
                return web.Response(text=f"Could not clean VM: ({str(e)})", status=400)
        else:
            try:
                res= await vm_proxy.vm_discard(self._gconf, self._call_system_service, vm_id, vm_version, zone_name, force)
                return json_response(res)
            except Exception as e:
                return web.Response(text=f"Could not discard VM version ({str(e)})", status=400)

    async def _api_launcher_post(self, request: web.Request):
        # analyse arguments
        try:
            data = await request.json()

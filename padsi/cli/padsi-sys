if __name__ == "__main__":
    try:
        uid = args.get("user")
        if uid is None:
            if "SUDO_UID" in os.environ:
                uid = int(os.environ.get("SUDO_UID", -1))
            else:
                # use the UID of the logged user if there is only one logger
                proc = subprocess.run(["loginctl", "list-sessions", "-j"], capture_output=True, text=True)
                if proc.returncode == 0:
                    data = json.loads(proc.stdout)
                    for item in data:
                        if item.get("seat") is not None:
                            if uid:
                                uid = None
                                break
                            else:
                                uid = item.get("uid")
        elif isinstance(uid, str):
            # convert name to UID
            try:
                uid=pwd.getpwnam(uid).pw_uid
            except Exception:
                raise Exception(f"Unknown user '{uid}'")

        cmde = args.get("cmde")
        if cmde is None:
            parser.print_help()
            sys.exit(1)

        zdata = None
        if cmde not in ("dump", "network", "pstree", "config-test", "adm-list", "adm-info", "adm-exec"):
            status = get_status_from_user_service(uid)
            if status is None:
                if uid is None:
                    raise Exception("Could not reach PADSI service, you need to specify a user (via the -U flag)")
                raise Exception("PADSI service not running?")
            # print(f"status: {json.dumps(status, indent=4)}")

            zone_name = args.get("zone")
            if not zone_name:
                raise Exception("No zone specified")
            if zone_name not in status.get("zones-available"):
                raise Exception(f"Zone '{zone_name}' is not available")

            if zone_name not in status.get("active-zones", []):
                if cmde not in ("network"):
                    raise Exception(f"Zone '{zone_name}' is not yet started")

            zdata = status.get("active-zones", []).get(zone_name)
            if zdata is None:
                raise Exception(f"Zone '{zone_name}' is not active")
            # print(f"ALL zdata: {json.dumps(zdata, indent=4)}")

        # actual handling
        match cmde:
            case "config-test":
                conf=load_config()
                # TODO:
                    # check that VM's RUN network requirements are met by the zone in which they are supposed to run
                    # check that there is a zone meeting the VM's INSTALL and UPDATE network requirements
                    # check that no zone and adminns have the same name (bad practice and breaks the "network-usage" command)

            case "pstree":
                command_pstree()
            case "dump":
                command_dump(args.get("user"))
            case "network":
                command_network(args, zdata)
            case "zone-parts":
                command_zone_parts(zdata)  # pyright: ignore
            case "zone-network":
                command_zone_network(args, zdata)
            case "zone-exec":
                interactive = args["interactive"]
                as_user = args["as_user"]
                cmdargs = args["args"]
                part = args["part"]
                (_, *extra) = part.split(":")
                filter = extra[0] if extra else None

                if part == "INFRA":
                    zdata = [get_infra(zdata)]
                elif part.startswith("DBUS"):
                    zdata = get_dbus_routers(zdata, filter)
                elif part.startswith("APPS"):
                    zdata = get_apps(zdata, filter)
                elif part.startswith("VM"):
                    found = False
                    vms = get_virtual_machines(zdata)
                    for nzone in vms:
                        if (
                            str(nzone.get("init-pid")) == filter
                            or nzone.get("vm-snap") == filter
                            or nzone.get("vm-nickname") == filter
                        ):
                            zdata = [nzone]
                            found = True
                            break
                    if not found:
                        zdata = vms if len(vms) == 1 else []
                else:
                    raise Exception(f"Invalid zone part specification '{part}'")

                assert(zdata is not None)
                if interactive or len(cmdargs) == 0:
                    if len(zdata) == 0:
                        raise Exception("No bubble to execute command into")
                    elif len(zdata) > 1:
                        raise Exception("More than one bubble to execute command into")
                    znode = zdata[0]
                    pid = znode.get("init-pid")
                    if pid is None:
                        raise Exception("Part to execute command into has no init process")
                    command_exec_interactive(pid, cmdargs, uid if as_user else None)  # pyright: ignore
                else:
                    command_exec(zdata, cmdargs)  # pyright: ignore

            case "adm-list":
                conf=load_config()
                exist_admns=get_admin_ns_list()
                for ns in exist_admns:
                    adminns=None
                    try:
                        adminns=conf.get_admin_ns(ns)
                        s=adminns.name if adminns.friendly_name==adminns.name else f"{adminns.name} ({adminns.friendly_name})"
                        print(f"{s}")

                    except Exception as e:
                        if adminns is None:
                            print(f"{Style.BRIGHT}{ns}{Style.RESET_ALL} {Fore.RED}not defined in the current configuration{Style.RESET_ALL}")
                        else:
                            print(f"{_indent}{Fore.RED}Error: {str(e)}{Style.RESET_ALL}")

            case "adm-info":
                conf=load_config()
                conf_admns=conf.get_admin_ns_names()
                ns=args.get("adminns", "")
                adminns=conf.get_admin_ns(ns)

                try:
                    s=adminns.name if adminns.friendly_name==adminns.name else f"{adminns.name}: {adminns.friendly_name}"
                    print(f"{s}")
                    print(f"Traffic shaper: {_get_traffic_shaper_descr(adminns.traffic_shaper)}")
                    # DNS
                    if adminns.has_dns_resolution:
                        if adminns.dns_resolvers is not None:
                            if len(adminns.dns_resolvers)==0:
                                print("DNS resolution provided by the host (NOT YET IMPLEMENTED)")
                            else:
                                print("DNS resolvers:")
                                for item in adminns.dns_resolvers:
                                    print(f"{_indent}{str(item.ip_address)}:{item.port} ({item.protocol.value})")
                            if adminns.out_resolv_rules is None or len(adminns.out_resolv_rules)==0:
                                print("No resolution rules")
                            else:
                                print("Domain resolution rules:")
                                for rule in adminns.out_resolv_rules:
                                    print(f"{_indent}{_format_rule(rule)}")
                        else:
                            print("No DNS resolution")
                    else:
                        print("Does not offer DNS resolution service")

                    # input access
                    if adminns.in_fw_rules is None or len(adminns.in_fw_rules)==0:
                        print("No network input access allowed")
                    else:
                        print("Network input access:")
                        if adminns.in_fw_rules is not None:
                            for rule in adminns.in_fw_rules:
                                print(f"{_indent}{_format_rule(rule)}")

                    # output direct access
                    if (adminns.out_fw_rules is None or len(adminns.out_fw_rules)==0) and (adminns.out_resolv_rules is None or len(adminns.out_resolv_rules)==0):
                        print("No direct network output access allowed")
                    else:
                        print("Direct network output access:")
                        if adminns.out_fw_rules is not None:
                            for rule in adminns.out_fw_rules:
                                print(f"{_indent}{_format_rule(rule)}")
                        if adminns.out_resolv_rules is not None:
                            for rule in adminns.out_resolv_rules:
                                print(f"{_indent}{_format_rule(rule)}")

                    # Web access via proxies
                    if len(adminns.web_proxies)==0:
                        print("No Web access via proxy configured")
                    else:
                        for proxy in adminns.web_proxies:
                            print(f"Web access via proxy '{proxy.descr}' ({proxy.host}:{proxy.port}):")
                            if proxy.fw_rules is not None:
                                for rule in proxy.fw_rules:
                                    print(f"{_indent}{_format_rule(rule)}")
                            if proxy.resolv_rules is not None:
                                for rule in proxy.resolv_rules:
                                    print(f"{_indent}{_format_rule(rule)}")
                except Exception as e:
                    if adminns is None:
                        print(f"{Style.BRIGHT}{ns}{Style.RESET_ALL} {Fore.RED}not defined in the current configuration{Style.RESET_ALL}")
                    else:
                        print(f"{Fore.RED}Error: {str(e)}{Style.RESET_ALL}")

                try:
                    data=get_admin_ns_infos(ns)
                    pid = data.get("init-pid")
                    if pid is None:
                        print(f"{Fore.MAGENTA}No associated PID{Style.RESET_ALL}")
                    else:
                        print(f"init PID: {pid}")
                except Exception as e:
                    print(f"{Fore.RED}Could not get NS information: {str(e)}{Style.RESET_ALL}")


            case "adm-exec":
                exist_admns=get_admin_ns_list()
                cmdargs = args["args"]
                ns=args["adminns"]
                if ns in exist_admns:
                    data=get_admin_ns_infos(ns)
                    pid = data.get("init-pid")
                    if pid is None:
                        raise Exception("Admin. namespace to execute command into has no init process")
                    command_exec_interactive(pid, cmdargs, None)
                else:
                    raise Exception(f"Unknown admin. NS '{ns}'")
            case _:
                raise Exception(f"Unknown command '{cmde}'")

    except Exception as e:
        print(f"Error: {str(e)}", file=sys.stderr)
        sys.exit(1)

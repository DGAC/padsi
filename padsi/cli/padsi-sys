def get_padsi_system_service_pid() -> int:
    proc = subprocess.run(
        ["systemctl", "show", "--property", "MainPID", "--value", "padsi"],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        raise Exception(f"Could not determine PADSI service's main process: {proc.stderr}")
    main_pid = int(proc.stdout)
    if main_pid == 0:
        raise Exception("PADSI service is not running")
    return main_pid


def get_padsi_user_service_pid(sysem_service_pid: int) -> int:
    system_service = psutil.Process(sysem_service_pid)
    user_service: psutil.Process | None = None
    for child in system_service.children():
        if child.uids()[0] == uid:
            user_service = child
            break
    if user_service is None:
        raise Exception(f"Could not find user service process for UID {uid}")
    return user_service.pid


#
# execution and parsing of processes in bubbles
#
def execute_command_in_process_ns(pid: int, args: list[str]) -> str:
    try:
        prog = subprocess.run(
            ["nsenter", "-m", "-p", "-n", "-t", str(pid)] + args,
            capture_output=True,
            text=True,
        )
        if prog.returncode != 0:
            raise Exception(prog.stderr if prog.stderr else prog.stdout)
        return prog.stdout
    except KeyboardInterrupt:
        return ""

def parse_ip_list_output(data: str) -> dict[str, ipaddress.IPv4Interface]:
    res = {}
    ifname: str | None = None
    for line in data.splitlines():
        if re.match(r"^[1-9][0-9]*:", line):
            (_, ifname, *_) = line.split()
            if ifname == "lo:":
                ifname = None
            else:
                ifname = ifname[:-1]
        elif "inet " in line and ifname is not None:
            line = line.strip()
            (_, addr, *_) = line.split()
            res[ifname] = ipaddress.IPv4Interface(addr)
            ifname = None
    return res


def get_status_from_user_service(uid: int | None) -> dict | None:
    if uid is None:
        proc = subprocess.run(["padsi-cli", "-j", "-v", "status"], capture_output=True, text=True)
    else:
        proc = subprocess.run(["padsi-cli", "-U", str(uid), "-j", "-v", "status"], capture_output=True, text=True)
    if proc.returncode == 2:  # PADSI service not running
        return None
    if proc.returncode != 0:
        raise Exception(f"Could not get output from padsi user service: {proc.stderr}")
    return json.loads(proc.stdout)


#
# filtering

def _show_traffic_shaper_info(tshaper: TrafficShaper):
    print(f"{Style.BRIGHT}Traffic shaper: {tshaper.name}{Style.RESET_ALL}")
    print(f"{_indent}type: {tshaper.ts_type}")
    print(f"{_indent}net namespace: {tshaper.net_ns}")
    if not tshaper.net_ns_exists:
        print(Fore.MAGENTA + f"{_indent}does not exist" + Fore.RESET)
    else:
        match tshaper.functionnal:
            case True:
                print(f"{_indent}is functionnal")
            case False:
                print(Fore.RED + f"{_indent}is not functionnal" + Fore.RESET)
            case _:
                print(Fore.RED + f"{_indent}could not determine if it is functionnal" + Fore.RESET)

        try:
            ifaces = padsi.network.list_interfaces(tshaper.net_ns)
            if len(ifaces) > 0:
                print(f"{_indent}network interfaces (in namespace):")
                for nsiface, ip in ifaces.items():
                    print(f"{_indent * 2}- {nsiface}: {str(ip)}")
        except Exception as e:
            print(Fore.MAGENTA + f"{_indent}cannot list network interfaces in namespace ({str(e)})" + Fore.RESET)

def _show_admin_ns_info(adminns:AdminNS):
    print(f"{Style.BRIGHT}Administration namespace: {adminns.name}{Style.RESET_ALL}")
    nsname=AdminInfra.get_admin_ns_name(adminns)
    print(f"{_indent}net namespace: {nsname}")

    proc=subprocess.run(["ip", "netns", "exec", nsname, "ss", "-atupn"], capture_output=True, text=True)
    if proc.returncode!=0:
        print(f"{_indent}{Fore.RED}Could not list processes in NS: {str(proc.stderr)}{Fore.RESET}")
    else:
        for line in proc.stdout.splitlines()[1:]:
            # ex.:
            # Netid State  Recv-Q  Send-Q  Local Address:Port   Peer Address:Port  Process
            # tcp   LISTEN 0       128     0.0.0.0:22           0.0.0.0:*          users:(("sshd",pid=1051379,fd=6))
            # tcp   TIME-WAIT 0      0     192.168.12.2:50058 192.168.13.1:2354
            try:
                (proto, state, _, _, local, peer, *proc)=line.split(maxsplit=6)
                (a, b)=local[::-1].split(":", maxsplit=1)
                laddr=b[::-1]
                lport=a[::-1]
                try:
                    ipaddress.IPv4Address(laddr)
                except ipaddress.AddressValueError:
                    ipaddress.IPv6Address(laddr[1:-1])
                    proto=proto+"6"
                match state:
                    case "LISTEN":
                        pid:str|None=None
                        if len(proc)==1:
                            for part in  proc[0].split(","):
                                if part.startswith("pid="):
                                    pid=part[4:]
                                    break
                        print(f"{_indent*2}- LISTEN {proto}:{lport} (PID: {pid if pid is not None else '???'})")
                    case "ESTAB"|"TIME-WAIT":
                        (a, b)=peer[::-1].split(":", maxsplit=1)
                        paddr=b[::-1]
                        pport=a[::-1]
                        print(f"{_indent*2}- {state} {proto}:{lport} {paddr}:{pport}")
                    case _:
                        print(f"{_indent*2}- {state} {proto}:{lport}")
            except Exception as e:
                print(f"{_indent*2}{Fore.RED}Invalid 'ss' output: {line.strip()}{Fore.RESET}: {str(e)}")

    if adminns.traffic_shaper is None:
        print(f"{_indent}direct network access")
    else:
        print(f"{_indent}via traffic shaper: {adminns.traffic_shaper.name}")
    if len(adminns.web_proxies)>0:
        print(f"{_indent}Web proxy: {', '.join([p.descr for p in adminns.web_proxies])}")
    else:
        print(f"{_indent}no Web proxy")

def command_network(args: dict, zdata: dict | None):
    """Print the system's network configuration"""
    root_required()

    # system's network settings
    ifaces=padsi.network.list_interfaces()
    if len(ifaces)>0:
        print(f"{Style.BRIGHT}Network interfaces in the 'init' namespace:{Style.RESET_ALL}")
        for (iface,addr) in ifaces.items():
            print(f"{_indent}{iface}: {addr}")

    # admin NS
    conf = load_config()
    if len(conf.admin_ns_list)==0:
        print("No administration namespace configured")
    else:
        for adminns in conf.admin_ns_list:
            _show_admin_ns_info(adminns)

    # traffic shapers
    for tshaper in conf.traffic_shapers:
        _show_traffic_shaper_info(tshaper)


def command_zone_network(args: dict, zdata: dict | None):
    """Print the network information (interfaces and IP addresses)"""
    root_required()
    conf = load_config()
    zone = args.get("zone")
    if zone is None:
        raise Exception("No zone specified")
    zone_conf = conf.get_zone(zone)

    tshaper = zone_conf.traffic_shaper
    if tshaper is not None:
        _show_traffic_shaper_info(tshaper)

    if zdata is not None:
        data = get_infra(zdata)
        if tshaper is None:
            iface = data.get("lower-iface")
            if iface is None:
                raise Exception("Lower interface is None???")
            print(f"Network interface (in host): {iface}")
            if padsi.network.interface_exists(iface):
                addr = padsi.network.addr_get(iface)
                print(f"{_indent}IP: {addr}")
            else:
                print(Fore.RED + f"{_indent}Does not exist" + Fore.RESET)

        pid = data.get("init-pid")
        if pid is None:
            raise Exception("Init PID is None???")
        print(f"{Style.BRIGHT}INFRA: init PID: {pid}{Style.RESET_ALL}")
        try:
            data = execute_command_in_process_ns(pid, ["ip", "a"])
            for iface, addr in parse_ip_list_output(data).items():
                print(f"{_indent}- {iface}: {addr}")
        except Exception as e:
            print(Fore.MAGENTA + f"{_indent * 2}{str(e)}" + Fore.RESET)

        for data in get_virtual_machines(zdata):
            print(f"{Style.BRIGHT}VM bubble {vm_name(data)}: init PID {pid}{Style.RESET_ALL}")
            try:
                data = execute_command_in_process_ns(pid, ["ip", "a"])
                for iface, addr in parse_ip_list_output(data).items():
                    print(f"{_indent}- {iface}: {addr}")
            except Exception as e:
                print(Fore.MAGENTA + f"{_indent}{str(e)}" + Fore.RESET)

        for data in get_apps(zdata, args.get("app")):
            pid=data.get("init-pid")
            print(f"{Style.BRIGHT}APPS: init PID {pid}{Style.RESET_ALL}")
            try:
                if pid is None:
                    raise Exception("CODEBUG: no 'init-pid' in reply")
                data = execute_command_in_process_ns(pid, ["ip", "a"])
                for iface, addr in parse_ip_list_output(data).items():
                    print(f"{_indent}- {iface}: {addr}")
            except Exception as e:
                print(Fore.MAGENTA + f"{_indent}{str(e)}" + Fore.RESET)
    else:
        print("Zone is not started")


def command_exec(zdata: dict, args: list[str]):
    """Execute a command (as root) and print its result"""
    root_required()
    for znode in zdata:
        pid = znode.get("init-pid")
        if pid is not None:
            try:
                data = execute_command_in_process_ns(pid, args)
                print(data, end="")
            except Exception as e:
                print(Fore.MAGENTA + f"{_indent}{str(e)}" + Fore.RESET)


def command_exec_interactive(pid: int, args: list[str], uid:int|None):
    """Execute an interactive command (bash by default) in the namespaces of the specified process"""
    root_required()
    if args is None or len(args) == 0:
        args = ["/bin/bash"]
    nsargs = ["nsenter", "-m", "-p", "-n"]
    if uid is not None:
        nsargs+=["-S", str(uid)]
    nsargs+=["-t", str(pid)] + args
    os.execvp(nsargs[0], nsargs)

def get_admin_ns_list() -> list[str]:
    proc=subprocess.run(["ip", "netns"], capture_output=True, text=True)
    if proc.returncode!=0:
        raise Exception(f"Could not execute 'ip netns': {proc.stderr}")
    res:list[str]=[]
    for line in proc.stdout.splitlines():
        (ns, *_)=line.split(maxsplit=1)
        if ns.startswith("admns"):
            (_, ns, _)=ns.split("-")
            res.append(ns)
    res.sort()
    return res

def get_admin_ns_infos(admns:str) -> dict:
    socket="/run/padsi/padsi/padsi-sserv.sock"
    if os.getuid() != 0:
        raise Exception("root privileges required")
    if not os.path.exists(socket):
        raise Exception("the PADSI system service does not appear to be running")
    socket=parse.quote_plus(socket)
    session=requests_unixsocket.Session()
    try:
        resp=session.get(f"http+unix://{socket}/status", timeout=30)
    except requests.exceptions.ConnectionError:
        raise Exception("PADSI service connection refused")
    if resp.ok:
        data=resp.json()
        if admns in data:
            return data[admns]
        else:
            if len(data)==0:
                raise Exception(f"Could not get information about the '{admns}' admin. namespace (service may still be starting)")
            raise Exception(f"Admin. service did not return information about the '{admns}' admin. namespace")
    raise Exception(resp.text)


def _get_traffic_shaper_descr(tsp: TrafficShaper|None) -> str:
    if tsp is None:
        return "direct network access"
    else:
        match tsp.functionnal:
            case True:
                return f"{tsp.name} ({tsp.ts_type}, functionnal)"
            case False:
                return f"{tsp.name} ({tsp.ts_type}, not functionnal)"
            case _:
                return f"{tsp.name} ({tsp.ts_type})"

def _format_rule(rule:FWRule|ResolvRule) -> str:
    if rule.action=="allow":
        return f"{Fore.GREEN}allowed{Fore.RESET} {rule.endpoint} {Style.DIM}({rule.descr}){Style.RESET_ALL}"
    else:
        return f"{Fore.MAGENTA}denied{Fore.RESET} {rule.endpoint} {Style.DIM}({rule.descr}){Style.RESET_ALL}"


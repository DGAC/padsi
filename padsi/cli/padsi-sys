def get_infra(zdata) -> dict:
    for znode in zdata:
        if znode.get("type") == "INFRA":
            return znode
    raise Exception("No infra. support found!")


def get_virtual_machines(zdata) -> list[dict]:
    res = []
    for znode in zdata:
        if znode.get("type") == "VM":
            res.append(znode)
    return res


def get_apps(zdata, pid_filter: int | None = None) -> list[dict]:
    res = []
    for znode in zdata:
        if znode.get("type") == "APPS":
            if pid_filter is None:
                res.append(znode)
            elif znode.get("init-pid") == pid_filter:
                res = [znode]
                break
            elif pid_filter == 0:
                if len(res) > 0:
                    raise Exception("More than one APP zone exists")
                res = [znode]
    return res


def get_dbus_routers(zdata, pid_filter: int | None = None) -> list[dict]:
    res = []
    for znode in zdata:
        if znode.get("type") == "DBUS-ROUTER":
            if pid_filter is None:
                res.append(znode)
            elif znode.get("init-pid") == pid_filter:
                res = [znode]
                break
            elif pid_filter == 0:
                if len(res) > 0:
                    raise Exception("More than one DBUS-ROUTER zone exists")
                res = [znode]
    return res


def root_required():
    """Ensure we are root"""
    if os.getuid() != 0:
        raise Exception("Must be run as root")



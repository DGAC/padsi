def command_pstree():
    """List all PADSI's processes"""
    pid = get_padsi_system_service_pid()
    proc = subprocess.run(["pstree", "-TpsuS", f"{pid}"])
    if proc.returncode != 0:
        raise Exception(f"Failed to execute 'pstree' for PADSI's main PID {pid}")


def command_dump(uid: int | None):
    """Show the whole system's networking structure"""
    # get the list of users on the system
    root_required()
    uids: list[int] = []
    for entry in pwd.getpwall():
        if (entry.pw_uid >= 1000 and entry.pw_name != "nobody"):  # real users except "nobody"
            uids.append(entry.pw_uid)

    # prepare structure for the diagram
    nmap = padsi.netmap.NetworkMap()

    # analyse PADSI's zones to get the PID of bubblewrap processes
    data={}
    for uid in uids:
        status = get_status_from_user_service(uid)
        if status is None:
            continue

        # enrich data with network interfaces
        for zone, bubbles in status.get("active-zones", {}).items():
            for bubble in bubbles:
                if "processes" in bubble:
                    del bubble["processes"]
                pid = bubble.get("init-pid")
                if pid is not None:
                    bubble["network"] = {}
                    for iface in nmap.get_ns_interfaces(pid):
                        if iface.name != "lo":
                            bubble["network"][iface.name] = {
                                "type": iface.iface_type.value if iface.iface_type is not None else None,
                                "addresses": [str(ip) for ip in iface.addresses] if iface.addresses is not None else None,
                            }
        data[uid]=status
    print(f"{json.dumps(data, indent=4)}")



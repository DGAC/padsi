def _get_traffic_shaper_descr(tsp: TrafficShaper|None) -> str:
    if tsp is None:
        return "direct network access"
    else:
        match tsp.functionnal:
            case True:
                return f"VPN {tsp.name} ({tsp.ts_type}, functionnal)"
            case False:
                return f"VPN {tsp.name} ({tsp.ts_type}, not functionnal)"
            case _:
                return f"VPN {tsp.name} ({tsp.ts_type})"

def print_zones(conf:padsi.config.Configuration, verbose:bool, use_json:bool):
    user_zones={zone.name: None if zone.friendly_name==zone.name else zone.friendly_name for zone in conf.zones}
    if use_json:
        data={
            "user-zones": user_zones,
        }
        print(f"{json.dumps(data, indent=4)}")
    else:
        for (zone, descr) in user_zones.items():
            if descr is None:
                print(f"{zone}")
            else:
                print(f"{zone}: {descr}")

def print_status(status:GlobalStatus, zone_name:str|None, tsp_name: str|None, verbose:bool):
    if zone_name is None and tsp_name is None:
        if len(status.active_zones)>0:
            print("Started zones:")
            for zname in status.active_zones:
                print(f"{_indent}{zname}")
                if verbose:
                    data=status.get_active_zones_status(zname)
                    if data is not None:
                        for zonestatus in data:
                            if zonestatus.vm_conf is None:
                                print(f"{_indent*2}{'ready' if zonestatus.ready else 'not ready'}")
                            else:
                                print(f"{_indent}*2{'ready' if zonestatus.ready else 'not ready'}, running VM: {zonestatus.vm_snap}/{zonestatus.vm_nickname}, ({zonestatus.vm_conf})")
        else:
            print("No zone started yet")
        if len(status.running_tasks)>0:
            print("Running tasks:")
            for task in status.running_tasks:
                print(f"{_indent}{task}")
        if len(status.traffic_shapers)>0:
            print("Traffic shapers:")
            for (name, tsp) in status.traffic_shapers.items():
                print(f"{_indent}{name}: {tsp.type}, {'is functionnal' if tsp.functionnal else 'is NOT functionnal'}")
        return

    if zone_name is None:
        if len(status.traffic_shapers)==0:
            raise Exception(f"Traffic shaper '{tsp_name}' not found")
        else:
            assert(tsp_name is not None)
            tsp=status.traffic_shapers.get(tsp_name)
            if tsp is None:
                raise Exception(f"CODEBUG: traffic shaper '{tsp_name}' not present in status")
            print(f"{'is functionnal' if tsp.functionnal else 'is NOT functionnal'}")
    else:
        if len(status.active_zones)==0:
            raise Exception(f"Zone '{zone_name}' not found")
        else:
            assert(zone_name is not None)
            if verbose:
                data=status.get_active_zones_status(zone_name)
                if data is not None:
                    for zonestatus in data:
                        if zonestatus.vm_conf is None:
                            print(f"{'ready' if zonestatus.ready else 'not ready'} for user applications")
                        else:
                            print(f"{'' if zonestatus.ready else 'not ready, '}running VM: {zonestatus.vm_snap}/{zonestatus.vm_nickname}, ({zonestatus.vm_conf})")


def print_vms(conf:padsi.config.Configuration, verbose:bool, use_json:bool):
    all_vms:dict[str,set[padsi.config.VirtualMachine]]={}
    for usage in padsi.config.VMUsage:
        for vm in conf.get_vms_for_usage(usage):
            if vm.id not in all_vms:
                all_vms[vm.id]=set()
            all_vms[vm.id].add(vm)

    data={}
    for vmid in all_vms:
        vmdata={
            "actions": []
        }
        for vm in all_vms[vmid]:
            if vm.is_user_allowed(get_user_id()):
                vmdata["actions"].append(vm.usage.value)
                if vm.usage==padsi.config.VMUsage.RUN:
                    vmdata["description"]=vm.description # pyright: ignore
                    zones:list[str]=[]
                    for zname in conf.get_zones_names():
                        zone=conf.get_zone(zname)
                        if vm.id in zone.get_virtual_machine_ids():
                            zones.append(zone.name)
                    vmdata["runnable-zone"]=zones
        data[vmid]=vmdata

    if use_json:
        print(f"{json.dumps(data, indent=4)}")
        return

    for (vmid, vmdata) in data.items():
        print(f"virtual machine '{vmid}': {vmdata['description']}")
        print(f"{_indent}actions: {', '.join(vmdata['actions'])}")
        print(f"{_indent}for zones: {', '.join(vmdata['runnable-zone'])}")

def _format_rule(rule:FWRule|ResolvRule) -> str:
    if rule.action=="allow":
        return f"{Fore.GREEN}allowed{Fore.RESET} {rule.endpoint} {Style.DIM}({rule.descr}){Style.RESET_ALL}"
    else:
        return f"{Fore.RED}blocked{Fore.RESET} {rule.endpoint} {Style.DIM}({rule.descr}){Style.RESET_ALL}"

class EventType(int, enum.Enum):
    ALLOWED = 0
    FAILED = 1
    BLOCKED = 2

class EventsGroup:
    """Handle lists of events to group them by timestamp into groups
    """
    span_s=300 # span in seconds during which events are groupped

    def __init__(self, ev_type:EventType, context:str, vm:str|None, ts:datetime.datetime):
        self._type=ev_type
        self._context=context
        self._vm=vm
        self._start_ts=ts
        self._last_ts=ts
        self.span=0
        self.nb_events=1

    @property
    def context(self) -> str:
        return self._context

    @context.setter
    def context(self, context:str):
        self._context=context
        self._type=EventType.FAILED # setting the context is actually only performed when the event is "failed"

    @property
    def vm(self)->str|None:
        return self._vm

    @property
    def ev_type(self) -> EventType:
        return self._type

    @property
    def start_ts(self) -> datetime.datetime:
        return self._start_ts

    @property
    def start_ts_str(self) -> str:
        return self._start_ts.strftime("%Y%m%d-%H:%M:%S")

    def add_event(self, ts:datetime.datetime) -> bool:
        if (ts-self._last_ts).seconds > EventsGroup.span_s:
            return False
        self.nb_events+=1
        self._last_ts=ts
        self.span=(ts-self._start_ts).seconds
        return True

    @staticmethod
    def _compute_timeline(lgroups:list[EventsGroup]) -> dict[str, list[EventsGroup]]:
        data: dict[str, list]={}
        for gr in lgroups:
            gr_str=str(gr)
            if gr_str in data:
                data[gr_str].append(gr)
            else:
                data[gr_str]=[gr]
        return data

    @staticmethod
    def serialize_list(lgroups:list[EventsGroup], as_timeline:bool) -> Any:
        if not as_timeline:
            return [{"ts": gr.start_ts_str, "name": str(gr), "vm":gr.vm, "count": gr.nb_events, "span": gr.span} for gr in lgroups]

        data=EventsGroup._compute_timeline(lgroups)
        return {req_name: [{"ts": gr.start_ts_str, "vm":gr.vm, "count": gr.nb_events, "span": gr.span} for gr in grlist] for (req_name, grlist) in data.items()}

    @staticmethod
    def merge_groups_by_ts(llgroups:list[list[EventsGroup]]) -> list[EventsGroup]:
        allg:dict[datetime.datetime, set[EventsGroup]]={}
        for lgroup in llgroups:
            for group in lgroup:
                if group.start_ts in allg:
                    allg[group.start_ts].add(group)
                else:
                    allg[group.start_ts]={group}
        res:list[EventsGroup]=[]
        for (_, s) in sorted(allg.items()):
            res+=list(s)
        return res

    @staticmethod
    def print_list(lgroups:list[EventsGroup], as_timeline:bool):
        if not as_timeline:
            for gr in lgroups:
                times="" if gr.nb_events==1 else f" {gr.nb_events} times"
                duration="" if gr.span<2 else f" over {gr.span} s"
                vm="" if gr.vm is None else f" [VM {gr.vm}]"
                print(f"{gr.start_ts_str} {gr}: {gr.context}{times}{duration}{vm}")
        else:
            data=EventsGroup._compute_timeline(lgroups)
            for req_name in data:
                print(f"{req_name}:")
                for gr in data[req_name]:
                    times="" if gr.nb_events==1 else f" {gr.nb_events} times"
                    duration="" if gr.span<2 else f" over {gr.span} s"
                    vm="" if gr.vm is None else f" [VM {gr.vm}]"
                    print(f"{_indent}{gr.start_ts_str}: {gr.context}{times}{duration}{vm}")

class DNSEventsGroup(EventsGroup):
    def __init__(self, ev_type:EventType, context:str, vm:str|None, ts:datetime.datetime, domain_name:str):
        super().__init__(ev_type, context, vm, ts)
        self._domain_name=domain_name

    def __repr__(self) -> str:
        return self._domain_name

def _parse_time_spec(spec:str) -> datetime.datetime:
    try:
        return datetime.datetime.strptime(spec, "%Y%m%d-%H:%M:%S")
    except Exception:
        try:
            return datetime.datetime.strptime(spec, "%Y%m%d")
        except Exception:
            try:
                return datetime.datetime.now()-datetime.timedelta(int(spec))
            except Exception:
                raise Exception(f"Invalid time specification '{spec}'")

def _compute_since_timestamp(since:str|None):
    if since is None:
        return datetime.datetime.now()-datetime.timedelta(1)
    return _parse_time_spec(since)

def _compute_until_timestamp(until:str|None):
    if until is None:
        return datetime.datetime.now()
    return _parse_time_spec(until)

def _get_logs_dirs(object:padsi.config.Zone|padsi.config.AdminNS|None, vms:list[str]|None) -> dict[str|None,str]:
    """Get a list of log directories indexed by VM name (<VM ID>:<VM nickname>) or None if no VM"""
    # get top logs directory
    uid=get_user_id()
    if isinstance(object, padsi.config.Zone):
        logs_dir=conf.get_zone_logs_dir(object.name, uid)
    elif isinstance(object, padsi.config.AdminNS):
        logs_dir=conf.get_admin_ns_logs_dir(object.name)
    elif object is None:
        logs_dir=conf.logs_dir
    else:
        raise Exception(f"CODEBUG: unexpected object type {type(object)}")

    if not os.path.isdir(logs_dir):
        if uid==0:
            raise Exception(f"Logs directory '{logs_dir}' is not a directory, maybe use the --user command line option")
        raise Exception(f"Logs directory '{logs_dir}' is not a directory or permission denied")

    res:dict[str|None,str]={}
    if vms is None or vms==[]:
        res[None]=logs_dir

    if vms!=[]:
        for fname in os.listdir(logs_dir):
            if fname.startswith("VM-"):
                vm_id=fname[3:]
                fpath=os.path.join(logs_dir, fname)
                for vm_name in os.listdir(fpath):
                    if vms is None or (vm_name in vms or f"{vm_id}:" in vms or f"{vm_id}:{vm_name}" in vms):
                        vmpath=os.path.join(fpath, vm_name)
                        if os.path.isdir(vmpath):
                            res[f"{vm_id}:{vm_name}"]=vmpath
    return res

def _parse_dns_log(logs_file:str, vm: str|None, show_allowed: bool, show_blocked:bool, since_ts:datetime.datetime, until_ts:datetime.datetime) -> list[EventsGroup]:
    lgroups:list[EventsGroup]=[]
    dgroups:dict[str,EventsGroup]={} # key=name, value=EventsGroup
    al_context=f"{Fore.GREEN}domain allowed{Fore.RESET}"
    bl_context=f"{Fore.RED}domain blocked{Fore.RESET}"
    try:
        with open(logs_file, "rt") as fd:
            for line in fd.readlines():
                # format: 20251120-17:29:19 INFO {"action": "req-block", "name": "firefox.settings.services.mozilla.com.", "type": "AAAA", "from": "192.168.0.2"}
                try:
                    (ts, level, jdata)=line.split(maxsplit=2)
                    data=json.loads(jdata)
                    name=data.get("name")

                    if data.get("type") in ("A", "AAAA"):
                        ts=datetime.datetime.strptime(ts, "%Y%m%d-%H:%M:%S")
                        if show_allowed and data.get("action")=="req-allow":
                            if ts>=since_ts and ts<=until_ts:
                                egr=dgroups.get(name)
                                if egr is None or not egr.add_event(ts):
                                    gr=DNSEventsGroup(EventType.ALLOWED, al_context, vm, ts, name)
                                    lgroups.append(gr)
                                    dgroups[name]=gr
                        if show_blocked and data.get("action") in ("req-block", "req-would-block"):
                            if ts>=since_ts and ts<=until_ts:
                                egr=dgroups.get(name)
                                if egr is None or not egr.add_event(ts):
                                    gr=DNSEventsGroup(EventType.BLOCKED, bl_context, vm, ts, name)
                                    lgroups.append(gr)
                                    dgroups[name]=gr

                except Exception as e:
                    print(f"Invalid log line '{line}': {str(e)}", file=sys.stderr)
        return lgroups
    except FileNotFoundError:
        raise Exception(f"Log file '{logs_file}' does not exist (may have been removed)")
    except PermissionError:
        raise Exception(f"Failed to read zone's resolution logs file {logs_file}: permission denied")
    except Exception as e:
        raise Exception(f"Failed to read zone's resolution logs file {logs_file}: {str(e)}")

def get_dns_usage(show_allowed: bool, show_blocked:bool, object:padsi.config.Zone|padsi.config.AdminNS|None,
    since:str|None, until:str|None, vms:list[str]|None) -> list[EventsGroup]:
    if object is None:
        return []
    since_ts=_compute_since_timestamp(since)
    until_ts=_compute_until_timestamp(until)
    logs_dirs=_get_logs_dirs(object, vms)

    lgroups:list[EventsGroup]=[]
    for (vm, ldir) in logs_dirs.items():
        lgroups+=_parse_dns_log(os.path.join(ldir, "resolv.log"), vm, show_allowed, show_blocked, since_ts, until_ts)
    return lgroups

class FirewallEventsGroup(EventsGroup):
    def __init__(self, ev_type:EventType, context:str, vm:str|None, ts:datetime.datetime, proto:str|None, in_iface:str|None, out_iface:str|None,
        ip_src:str|None, ip_dst:str|None, port_src:int|None, port_dst:int|None):
        super().__init__(ev_type, context, vm, ts)
        src:Endpoint|None=None
        dst:Endpoint|None=None
        self._flow:NetFlow|None=None
        if proto is None:
            if in_iface is not None:
                dst=Endpoint(f"#{in_iface}")
            if out_iface is not None:
                src=Endpoint(f"#{out_iface}")
            self._flow=NetFlow(src, dst)
        else:
            self._proto=proto.lower()
            if self._proto in ("tcp", "udp", "icmp"):
                if in_iface is not None:
                    src=Endpoint(ip_src, self._proto, str(port_src) if port_src is not None else None)
                elif out_iface is not None:
                    src=Endpoint(f"#{out_iface}", self._proto, str(port_src) if port_src is not None else None)
                if out_iface is not None:
                    dst=Endpoint(ip_dst, self._proto, str(port_dst) if port_dst is not None else None)
                elif in_iface is not None:
                    dst=Endpoint(f"#{in_iface}", self._proto, str(port_dst) if port_dst is not None else None)
                self._flow=NetFlow(src, dst)

    def __repr__(self) -> str:
        if self._flow is None:
            return f"protocol {self._proto}"
        return str(self._flow)

def _parse_firewall_log(logs_dir:str, vm: str|None, show_allowed: bool, show_blocked:bool, since_ts:datetime.datetime, until_ts:datetime.datetime) -> list[EventsGroup]:
    lgroups:list[EventsGroup]=[]
    dgroups:dict[str,EventsGroup]={} # key=name, value=EventsGroup

    for fname in os.listdir(logs_dir):
        if fname.startswith("firewall.") and fname.endswith(".json"):
            start_ts=datetime.datetime.strptime(fname[9:-5], "%Y-%m-%d")
            if start_ts>=since_ts-datetime.timedelta(days=1) and start_ts<=until_ts:
                logs_file=os.path.join(logs_dir, fname)
                try:
                    with open(logs_file, "tr") as fd:
                        for line in fd.readlines():
                            try:
                                data=json.loads(line)
                                (ts, *_)=data["timestamp"].split(".")
                                ts=datetime.datetime.strptime(ts, "%Y-%m-%dT%H:%M:%S")
                                if ts>=since_ts and ts<=until_ts:
                                    in_iface=data.get("in_iface")
                                    out_iface=data.get("out_iface")
                                    if in_iface is None:
                                        if out_iface is None:
                                            context=f"{Fore.RED}firewall blocked{Fore.RESET}"
                                        else:
                                            context=f"{Fore.RED}firewall INFRA OUT blocked{Fore.RESET}"
                                    else:
                                        if out_iface is None:
                                            context=f"{Fore.RED}firewall INFRA IN blocked{Fore.RESET}"
                                        else:
                                            context=f"{Fore.RED}firewall blocked{Fore.RESET}"
                                    gr=FirewallEventsGroup(EventType.BLOCKED, context, vm, ts, data.get("proto"),
                                        in_iface, out_iface,
                                        data.get("ip_src"), data.get("ip_dst"),
                                        data.get("port_src"), data.get("port_dst"))
                                    egr=dgroups.get(str(gr))
                                    if egr is None or not egr.add_event(ts):
                                        lgroups.append(gr)
                                        dgroups[str(gr)]=gr
                            except Exception as e:
                                print(f"Invalid log line '{line}': {str(e)}", file=sys.stderr)
                except FileNotFoundError:
                    pass
                except Exception as e:
                    raise Exception(f"Failed to read zone's firewall logs file {logs_file}: {str(e)}")
    return lgroups

def get_blocked_firewall_usage(object:padsi.config.Zone|padsi.config.AdminNS|None,
    since:str|None, until:str|None, vms:list[str]|None) -> list[EventsGroup]:
    since_ts=_compute_since_timestamp(since)
    until_ts=_compute_until_timestamp(until)
    logs_dirs=_get_logs_dirs(object, vms)

    lgroups:list[EventsGroup]=[]
    for (vm, ldir) in logs_dirs.items():
        lgroups+=_parse_firewall_log(ldir, vm, show_allowed, show_blocked, since_ts, until_ts)
    return lgroups

class ProxyEventsGroup(EventsGroup):
    def __init__(self, ev_type:EventType, context:str, vm:str|None, ts:datetime.datetime, endpoint:str, cl_ip:str|None, cl_port:int|None):
        super().__init__(ev_type, context, vm, ts)
        self._endpoint=endpoint
        self._id=self._endpoint if cl_ip is None and cl_port is None else f"{self._endpoint}/{cl_ip}:{cl_port}"

    @property
    def id(self) -> str:
        return self._id

    def __repr__(self) -> str:
        return self._endpoint

    @staticmethod
    def compact_groups(groups:list[EventsGroup]) -> list[EventsGroup]:
        def _downcast(obj:EventsGroup) -> ProxyEventsGroup:
            if not isinstance(obj, ProxyEventsGroup):
                raise Exception("CODEBUG: obj is not a ProxyEventsGroup")
            return obj

        dgroups:dict[str,EventsGroup]={}
        lgroups:list[EventsGroup]=[]
        for gr in groups:
            pgr=_downcast(gr)
            egr=dgroups.get(pgr._endpoint)
            if egr is None or not egr.add_event(gr.start_ts):
                dgroups[pgr._endpoint]=gr
                lgroups.append(gr)
        return lgroups

def _parse_proxy_log(logs_dir:str, vm: str|None, show_allowed: bool, show_failed: bool, show_blocked:bool, since_ts:datetime.datetime, until_ts:datetime.datetime) -> list[EventsGroup]:
    lgroups:list[EventsGroup]=[]
    dgroups:dict[str,EventsGroup]={} # key=name, value=EventsGroup
    def _get_client_ip_port(spans: list[dict]|None) -> tuple[str|None,int|None]:
        if spans is not None:
            for span in spans:
                if "client_ip" in span and "client_port" in span:
                    return (span["client_ip"], span["client_port"])
        return (None, None)

    # analyse logs
    al_context=f"{Fore.GREEN}web proxy allowed{Fore.RESET}"
    fa_context=f"{Fore.MAGENTA}web proxy failed{Fore.RESET}"
    bl_context=f"{Fore.RED}web proxy blocked{Fore.RESET}"
    for fname in os.listdir(logs_dir):
        if fname.startswith("web-infra.") and fname.endswith(".json"):
            try:
                start_ts=datetime.datetime.strptime(fname[10:-5], "%Y-%m-%d")
            except Exception:
                raise Exception(f"Could not convert '{fname[10:-5]} ({fname})' to a timestamp")
            if start_ts>=since_ts-datetime.timedelta(days=1) and start_ts<=until_ts:
                logs_file=os.path.join(logs_dir, fname)
                try:
                    with open(logs_file, "tr") as fd:
                        for line in fd.readlines():
                            try:
                                data=json.loads(line)
                                (ts, *_)=data["timestamp"].split(".")
                                ts=datetime.datetime.strptime(ts, "%Y-%m-%dT%H:%M:%S")
                                if ts>=since_ts and ts<=until_ts:
                                    # don't report if corresponds to a VM
                                    (cl_ip, cl_port)=_get_client_ip_port(data.get("spans"))
                                    if vm is None and cl_ip not in ("192.168.0.2", "192.168.128.2"):
                                        continue

                                    # determine if actually blocked outside of PADSI
                                    up_proxy=data.get("up_proxy_blocked")
                                    up_conn=data.get("up_conn_blocked")
                                    up_bl_endpoint=up_proxy if up_proxy is not None else up_conn

                                    if up_bl_endpoint is not None:
                                        # complement corresponding and already parsed allowed endpoint access to make it failed
                                        gr=ProxyEventsGroup(EventType.ALLOWED, al_context, vm, ts, up_bl_endpoint, cl_ip, cl_port)
                                        egr=dgroups.get(gr.id)
                                        if egr is not None:
                                            if show_failed:
                                                msg=data.get("message")
                                                msg=re.sub(' .os error [0-9]+.', '', msg)
                                                extra=(
                                                    f"{Fore.RED}blocked{Fore.RESET} by proxy ({msg})" if up_proxy is not None else
                                                    f"{Fore.RED}blocked{Fore.RESET} by network ({msg})")
                                                egr.context=f"{fa_context}, {extra}"
                                            else:
                                                del dgroups[gr.id]
                                    else:
                                        al_endpoint=data.get("allowed") # endpoint which has been allowed
                                        bl_endpoint=data.get("blocked") # endpoint which has been blocked

                                        if (show_allowed or show_failed) and al_endpoint is not None:
                                            gr=ProxyEventsGroup(EventType.ALLOWED, al_context, vm, ts, al_endpoint, cl_ip, cl_port)
                                            egr=dgroups.get(gr.id)
                                            if egr is None or not egr.add_event(ts):
                                                lgroups.append(gr)
                                                dgroups[gr.id]=gr

                                        elif show_blocked and bl_endpoint is not None:
                                            (cl_ip, cl_port)=_get_client_ip_port(data.get("spans"))
                                            gr=ProxyEventsGroup(EventType.BLOCKED, bl_context, vm, ts, bl_endpoint, cl_ip, cl_port)
                                            egr=dgroups.get(gr.id)
                                            if egr is None or not egr.add_event(ts):
                                                lgroups.append(gr)
                                                dgroups[gr.id]=gr

                            except Exception as e:
                                print(f"Invalid log line '{line}': {str(e)}", file=sys.stderr)
                except FileNotFoundError:
                    pass
                except Exception as e:
                    raise Exception(f"Failed to read zone's Web proxy logs file {logs_file}: {str(e)}")
    if not show_allowed:
        # remove all allowed information which was captured because it might be failed but was not requested
        nlgroups:list[EventsGroup]=[]
        for gr in lgroups:
            if gr.ev_type!=EventType.ALLOWED:
                nlgroups.append(gr)
        lgroups=nlgroups

    return ProxyEventsGroup.compact_groups(lgroups)

def get_proxy_usage(show_allowed: bool, show_failed:bool, show_blocked:bool,
    object:padsi.config.Zone|padsi.config.AdminNS|None, since:str|None, until:str|None, vms:list[str]|None) -> list[EventsGroup]:
    since_ts=_compute_since_timestamp(since)
    until_ts=_compute_until_timestamp(until)
    logs_dirs=_get_logs_dirs(object, vms)

    lgroups:list[EventsGroup]=[]
    for (vm, ldir) in logs_dirs.items():
        lgroups+=_parse_proxy_log(ldir, vm, show_allowed, show_failed, show_blocked, since_ts, until_ts)
    return lgroups

def print_user_zone_infos(gconf:padsi.config.Configuration, zone:padsi.config.Zone, verbose:bool, use_json:bool):
    if use_json:
        data=zone.serialize()
        print(f"{json.dumps(data, indent=4)}")
        return

    s=zone.name if zone.friendly_name==zone.name else f"{zone.name} ({zone.friendly_name})"
    print(f"Zone name: {s}")
    print(f"Has network: {zone.network_enabled}")
    if len(zone.configured_options)>0:
        print("Configured options:")
        for (option_type, option_value) in zone.configured_options.items():
            print(f"{_indent}{option_type.value}: {str(option_value)}")
    else:
        print("No configured option")

    if zone.network_enabled:
        # traffic shaper
        if zone.traffic_shaper:
            print(f"Traffic shaper: {_get_traffic_shaper_descr(zone.traffic_shaper)}")
        else:
            print("Does not use any traffic shaper")

        # DNS
        if zone.has_dns_resolution:
            if zone.dns_resolvers is not None:
                if len(zone.dns_resolvers)==0:
                    print("DNS resolution provided by the host (NOT YET IMPLEMENTED)")
                else:
                    print("DNS resolvers:")
                    for item in zone.dns_resolvers:
                        print(f"{_indent}{str(item.ip_address)}:{item.port} ({item.protocol.value})")
                if zone.resolv_rules is None or len(zone.resolv_rules)==0:
                    print("No resolution rules")
                else:
                    print("Domain resolution rules:")
                    for rule in zone.resolv_rules:
                        print(f"{_indent}{_format_rule(rule)}")
            else:
                print("No DNS resolution")
        else:
            print("Does not offer DNS resolution service")

        # direct access
        if (zone.fw_rules is None or len(zone.fw_rules)==0) and (zone.resolv_rules is None or len(zone.resolv_rules)==0):
            print("No direct network access allowed")
        else:
            print("Direct network access:")
            if zone.fw_rules is not None:
                for rule in zone.fw_rules:
                    print(f"{_indent}{_format_rule(rule)}")
            if zone.resolv_rules is not None:
                for rule in zone.resolv_rules:
                    print(f"{_indent}{_format_rule(rule)}")

        # Web access via proxies
        if len(zone.web_proxies)==0:
            print("No Web access via proxy configured")
        else:
            for proxy in zone.web_proxies:
                print(f"Web access via proxy '{proxy.descr}' ({proxy.host}:{proxy.port}):")
                if proxy.fw_rules is not None:
                    for rule in proxy.fw_rules:
                        print(f"{_indent}{_format_rule(rule)}")
                if proxy.resolv_rules is not None:
                    for rule in proxy.resolv_rules:
                        print(f"{_indent}{_format_rule(rule)}")

    # runnable VMs
    vms:list[padsi.config.VirtualMachine]=[]
    for vmid in zone.get_virtual_machine_ids():
        vm=zone.get_virtual_machine(vmid)
        if vm is not None and vm.is_user_allowed(get_user_id()):
            vms.append(vm)
    if len(vms)>0:
        print("Virtual machines to run:")
        for vm in vms:
            print(f"  - {vm.id} ({vm.description})")
    else:
        print("No virtual machines allowed be be run")

    # clipboard sharing
    print("Clipboard sharing restrictions")
    pzones=gconf.get_clipboard_allowed_zones(zone.name)
    if zone.name not in pzones:
        pzones.add(zone.name)
    pzones=sorted(pzones)
    print(f"{_indent}can paste data copied from zones: {', '.join(pzones)}")
    czones:list[str]=[zone.name]
    for zname in gconf.get_zones_names():
        if zname!=zone.name:
            pzones=gconf.get_clipboard_allowed_zones(zname)
            if zone.name in pzones:
                czones.append(zname)
    czones.sort()
    print(f"{_indent}copied data can be pasted into zones: {', '.join(czones)}")

def print_net_access(conf:padsi.config.Configuration, endpoint:str, text_match:bool, use_json:bool):
    jdata={}
    def _add_zone_rule(zone:padsi.config.Zone, rule:FWRule|ResolvRule, proxy:padsi.config.Proxy|None=None):
        rdata={
            "action": rule.action,
            "descr": rule.descr,
            "endpoint": str(rule.endpoint)
        }
        if proxy is not None:
            rdata["proxy"]=proxy.descr
        if zone.name in jdata:
            jdata[zone.name].append(rdata)
        else:
            jdata[zone.name]=[rdata]

    for zone in conf.zones:
        handled:bool=False
        if text_match:
            if zone.fw_rules is not None:
                for rule in zone.fw_rules:
                    if endpoint in str(rule.endpoint):
                        if use_json:
                            _add_zone_rule(zone, rule)
                        else:
                            print(f"Zone {zone.name}: {_format_rule(rule)}")
                        handled=True
            if zone.resolv_rules is not None:
                for rule in zone.resolv_rules:
                    if endpoint in str(rule.endpoint):
                        if use_json:
                            _add_zone_rule(zone, rule)
                        else:
                            print(f"Zone {zone.name}: {_format_rule(rule)}")
                        handled=True
            for proxy in zone.web_proxies:
                if proxy.fw_rules is not None:
                    for rule in proxy.fw_rules:
                        if endpoint in str(rule.endpoint):
                            if use_json:
                                _add_zone_rule(zone, rule, proxy)
                            else:
                                print(f"Zone {zone.name} (via proxy '{proxy.descr}'): {_format_rule(rule)}")
                            handled=True
                if proxy.resolv_rules is not None:
                    for rule in proxy.resolv_rules:
                        if endpoint in str(rule.endpoint):
                            if use_json:
                                _add_zone_rule(zone, rule, proxy)
                            else:
                                print(f"Zone {zone.name} (via proxy '{proxy.descr}'): {_format_rule(rule)}")
                            handled=True
        else:
            ep=Endpoint.from_repr(endpoint)
            if zone.fw_rules is not None:
                for rule in zone.fw_rules:
                    if ep.is_part_of(rule.endpoint):
                        if use_json:
                            _add_zone_rule(zone, rule)
                        else:
                            print(f"Zone {zone.name}: {_format_rule(rule)}")
                        handled=True
            if zone.resolv_rules is not None:
                for rule in zone.resolv_rules:
                    if ep.is_part_of(rule.endpoint):
                        if use_json:
                            _add_zone_rule(zone, rule)
                        else:
                            print(f"Zone {zone.name}: {_format_rule(rule)}")
                        handled=True
            for proxy in zone.web_proxies:
                if proxy.fw_rules is not None:
                    for rule in proxy.fw_rules:
                        if ep.is_part_of(rule.endpoint):
                            if use_json:
                                _add_zone_rule(zone, rule, proxy)
                            else:
                                print(f"Zone {zone.name} (via proxy '{proxy.descr}'): {_format_rule(rule)}")
                            handled=True
                if proxy.resolv_rules is not None:
                    for rule in proxy.resolv_rules:
                        if ep.is_part_of(rule.endpoint):
                            if use_json:
                                _add_zone_rule(zone, rule, proxy)
                            else:
                                print(f"Zone {zone.name} (via proxy '{proxy.descr}'): {_format_rule(rule)}")
                            handled=True
        if not handled:
            if use_json:
                _add_zone_rule(zone, FWRule("deny", "default", Endpoint.from_repr("*")))
            else:
                print(f"Zone {zone.name}: {Fore.RED}blocked{Fore.RESET} by default")
    if use_json:
        print(f"{json.dumps(jdata, indent=4)}")

def get_user_id() -> int:
    user=args.get("user")
    uid=os.getuid()
    if user is not None:
        try:
            uid=int(user)
        except ValueError:
            try:
                uid=pwd.getpwnam(user).pw_uid
            except KeyError:
                raise Exception(f"Unknown user '{user}'")
    return uid

def get_service_client(can_be_admin:bool=False)->Client|ClientAdmin:
    """Connect to the the PADSI service,
    raise an exception if the service can't be reached
    """
    uid=get_user_id()
    try:
        return Client(uid)
    except Exception as e:
        if can_be_admin:
            return ClientAdmin()
        raise e

def prepare_extra_isos(resources:list[str]|None) -> tuple[list[str],str|None]:
    """For each file name in the specified list:
    - if the file is an ISO, returns it AS-IS in the 1st part of the tuple
    - all the other files are groupped in a single ISO file as a temporary file returned as a single file in the 2nd part of the tuple

    Notes:
    - also include the PADSI agent packages in the ISO containing the 'files' resources
    - it's up to the caller to remove that ISO file when needed anymore
    """
    if resources is None:
        resources=[]

    # include PADSI's VM agent packages
    packages:list[str]=[]
    packages_dir:str=os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__)))), "packages") # pyright: ignore
    if os.path.isdir(packages_dir): # pyright: ignore
        for fname in os.listdir(packages_dir): # pyright: ignore
            fpath=os.path.join(packages_dir, fname)
            found=False
            for respath in resources:
                if os.path.samefile(respath, fpath): # pyright: ignore
                    found=True
                    break
            if not found:
                packages.append(fpath)

    # actually prepare the final result
    res1:list[str]=[]
    res2:str|None=None
    files:list[str]=[]
    try:
        for fname in resources +  packages:
            if not os.path.isabs(fname):
                fname=os.path.realpath(fname)
            if padsi.misc.is_iso_image(fname):
                res1.append(fname)
            else:
                files.append(fname)
        if len(files)>0:
            res2=tempfile.mkstemp(".iso")[1]
            padsi.misc.generate_iso_image(files, "Resources", res2)
    except Exception as e:
        raise Exception(f"Error: {str(e)}")
    return (res1, res2)


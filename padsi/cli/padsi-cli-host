try:
    verbose=args.get("verbose", False)
    use_json=args.get("json", False)
    cmde=args["cmde"]
    match cmde:
        case "status":
            client=get_service_client()
            if not isinstance(client, Client):
                raise Exception("CODEBUG: get_service_client() returned an AdminClient, expected a Client")
            zone=args.get("zone")
            tsp=args.get("tsp")
            status=client.get_status(zone, tsp)
            if use_json:
                print(f"{json.dumps(status.raw_data, indent=4)}")
            else:
                print_status(status, zone, tsp, verbose)

        case "run":
            if len(args)==0:
                raise Exception("Invalid arguments")
            client=get_service_client()
            data=client.run(args["zone-name"], args["args"]) # pyright: ignore
            if use_json:
                print(f"{json.dumps(data, indent=4)}")
            else:
                print(f"PID: {data.get('pid', '???')}") # pyright: ignore

        case "net-rules":
            conf=load_config()
            print_net_access(conf, args.get("endpoint", ""), bool(args.get("text")), use_json)

        case "net-check":
            tsp=args.get("tsp")
            if tsp is not None:
                conf=load_config()
                tsp=conf.get_traffic_shaper(tsp)
                if tsp is None:
                    raise Exception(f"Unknown traffic shaper '{tsp}'")
                state=tsp.functionnal
                match state:
                    case True:
                        print("Ok")
                        sys.exit(0)
                    case False:
                        print("Not functionnal")
                    case None:
                        print("Could not determine state (insufficient privileges?)", file=sys.stderr)
                sys.exit(1)
            raise Exception("No network interface to check")

        #
        # VM management
        #
        case "vm-list":
            # data is displayed from the configuration, not the PADSI service itself
            print_vms(load_config(), verbose, use_json)

        case "vm-discard":
            client=get_service_client(True)
            versions:list[str]=[]
            for vm_name in args["vm-name"]:
                data=client.vm_discard(args["vm-id"], vm_name, args.get("zone"), force=args["force"])
                versions+=data
            if use_json:
                print(f"{json.dumps(versions, indent=4)}")
            else:
                if len(versions)>0:
                    for vmversion in versions:
                        print(f"{vmversion}")
                else:
                    print("No VM version specified")

        case "vm-clean":
            client=get_service_client(True)
            data=client.vm_clean(args["vm-id"], args.get("zone"))
            if use_json:
                print(f"{json.dumps(data, indent=4)}")
            else:
                for vmversion in data:
                    print(f"{vmversion}")

        case "vm-merge":
            client=get_service_client(True)
            data=client.vm_merge(args["vm-id"],
               args.get("vm-name"), args.get("zone"), args["message"]) # pyright: ignore
            if use_json:
                print(f"{json.dumps(data, indent=4)}")
            else:
                print(f"{json.dumps(data, indent=4)}") # TODO

        case "vm-install":
            client=get_service_client()
            boot_iso=args.get("iso")
            if boot_iso is None:
                raise Exception("No bootable ISO specified")
            if not os.path.isabs(boot_iso):
                boot_iso=os.path.realpath(boot_iso)

            # extra resources
            extra_isos=None
            iso_file=None
            (extra_isos, iso_file)=prepare_extra_isos(args.get("resource"))

            # actual install
            data=client.vm_install(args["vm-id"], zone_name=args.get("network_of_zone"), boot_iso=boot_iso, extra_isos=extra_isos, iso_file=iso_file) # pyright: ignore
            if use_json:
                print(f"{json.dumps(data, indent=4)}")
            else:
                if data is not None:
                    print(f"VM version: {data.get('vm-version')}")
                    print(f"Zone name: {data.get('zone')}")
                else:
                    print("No information returned", file=sys.stderr)

        case "vm-import":
            client=get_service_client(True)
            hdd_file=args["hdd-file"]
            if not os.path.isabs(hdd_file):
                hdd_file=os.path.join(os.path.realpath(os.path.curdir), hdd_file)
            vars_file=args["vars-file"]
            if not os.path.isabs(vars_file):
                vars_file=os.path.join(os.path.realpath(os.path.curdir), vars_file)

            data=client.vm_import(args["vm-id"], hdd_file, vars_file, args["message"])
            if use_json:
                print(f"{json.dumps(data, indent=4)}")
            else:
                print(f"VM version: {data}")

        case "vm-save":
            conf=load_config()
            client=get_service_client(True)
            client.vm_save(conf, args["vm-id"], args["vm-name"], args["archive-file"], args.get("depend_at"))

        case "vm-load":
            conf=load_config()
            client=get_service_client(True)
            ar_file=args["archive-file"]
            if not os.path.isabs(ar_file):
                ar_file=os.path.join(os.path.realpath(os.path.curdir), ar_file)
            client.vm_load(conf, ar_file, args["vm_id"], args["message"])

        case "vm-update":
            client=get_service_client()
            extra_isos=None
            iso_file=None
            (extra_isos, iso_file)=prepare_extra_isos(args.get("resource"))
            data=client.vm_update(args["vm-id"], zone_name=args.get("network_of_zone"), extra_isos=extra_isos, iso_file=iso_file) # pyright: ignore
            if use_json:
                print(f"{json.dumps(data, indent=4)}")
            else:
                print(f"VM version: {data['vm-version']}") # pyright: ignore

        case "vm-publish":
            client=get_service_client()
            data=client.vm_publish(args["vm-id"], args["message"]) # pyright: ignore
            if use_json:
                print(f"{json.dumps(data, indent=4)}")
            else:
                print(f"{json.dumps(data, indent=4)}") # TODO

        case "vm-status":
            client=get_service_client(True)
            zone_name=args.get("zone")
            print_vm_status(client.get_vm_status(args["vm-id"], zone_name, verbose), zone_name, verbose, use_json, _indent)
        case "vm-start":
            if len(args)==0:
                raise Exception("Invalid arguments")
            client=get_service_client()
            data=client.vm_start(args["vm-id"], args["zone-name"], args.get("vm-name")) # pyright: ignore
            if data is not None:
                if use_json:
                    print(f"{json.dumps(data, indent=4)}")
                else:
                    print(f"{json.dumps(data, indent=4)}") # TODO

        case "vm-display":
            if len(args)==0:
                raise Exception("Invalid arguments")
            client=get_service_client()
            client.vm_display(args["vm-id"], args["zone-name"], args.get("vm-name")) # pyright: ignore

        case "vm-create-launcher":
            if len(args)==0:
                raise Exception("Invalid arguments")
            client=get_service_client()
            client.vm_launcher_create(args["vm-id"], args["zone-name"], args.get("vm-name")) # pyright: ignore

        case "vm-delete-launcher":
            if len(args)==0:
                raise Exception("Invalid arguments")
            client=get_service_client()
            client.vm_launcher_delete(args["vm-id"], args["zone-name"], args.get("vm-name")) # pyright: ignore


        #
        # Zones management
        #
        case "zone-info":
            conf=load_config()
            zone=conf.get_zone(args.get("zone-name", "unspecified"))
            print_user_zone_infos(conf, zone, verbose, use_json) # pyright: ignore

        case "net-usage":
            show_blocked=True
            show_failed=True
            show_allowed=False
            status=args.get("status")
            if status is not None:
                if status=="all":
                    show_allowed=True
                else:
                    parts=status.split(",")
                    for p in parts:
                        if p not in ("blocked", "failed", "allowed"):
                            raise Exception(f"Invalid status '{p}'")
                    show_blocked="blocked" in parts
                    show_failed="failed" in parts
                    show_allowed="allowed" in parts

            events_list="dns,firewall,proxy".split(",")
            events=args.get("events")
            if events is not None:
                events_list=events.split(",")

            since=args.get("since")
            until=args.get("until")
            as_timeline=not args.get("no_timeline", True)

            vms:list[str]|None=None # => handle logs from all VMs
            vms_arg=args.get("vm")
            if vms_arg is not None:
                vms=[]
                for item in vms_arg.split(","):
                    item=item.strip()
                    if item:
                        vms.append(item)
                if vms==["none"]:
                    vms=[] # => ignore logs from any VM

            conf=load_config()
            name_arg=args.get("name", "infaillible")
            obj:Any|None=None # will be None for the 'init namespace'
            if name_arg=="":
                raise Exception("Invalid empty name")
            elif name_arg=="-":
                pass
            elif name_arg[0]=="@":
                try:
                    obj=conf.get_admin_ns(name_arg[1:])
                except Exception:
                    raise Exception(f"No admin. NS '{name_arg[1:]}'")
            else:
                try:
                    obj=conf.get_zone(name_arg)
                except Exception:
                    raise Exception(f"No zone '{name_arg[1:]}'")

            all_collected=[] # in case of JSON output
            handled=False

            if obj is None:
                if events_list==["dns"]: # user only asked for this, so return an error
                    raise Exception("No DNS resolution in the 'init namespace'")
                if events_list==["proxy"]: # user only asked for this, so return an error
                    raise Exception("No Web proxy in the 'init namespace'")

            if "dns" in events_list:
                data=get_dns_usage(show_allowed, show_blocked, obj, since, until, vms)
                all_collected.append(data)
                handled=True
            if "firewall" in events_list:
                if show_blocked:
                    data=get_blocked_firewall_usage(obj, since, until, vms)
                    all_collected.append(data)
                handled=True
            if "proxy" in events_list:
                data=get_proxy_usage(show_allowed, show_failed, show_blocked, obj, since, until, vms)
                all_collected.append(data)
                handled=True

            if not handled:
                raise Exception(f"Invalid events '{events}' specified")

            lgroups=EventsGroup.merge_groups_by_ts(all_collected)
            if use_json:
                data=EventsGroup.serialize_list(lgroups, as_timeline)
                print(f"{json.dumps(data, indent=4)}")
            else:
                EventsGroup.print_list(lgroups, as_timeline)

        case "zones":
            print_zones(load_config(), verbose, use_json)

        case _:
            raise Exception(f"Unhandled command '{cmde}'")
except KeyboardInterrupt:
    pass
except Exception as e:
    if False:
        print("========== DEBUG ==========")
        raise e

    if not os.isatty(sys.stdout.fileno()):
        try:
            import gi
            gi.require_version("Notify", "0.7")
            from gi.repository import Notify  # pyright: ignore
            Notify.init("PADSI")
            n=Notify.Notification.new("Error", str(e), "dialog-error")
            n.show()
        except Exception:
            print(f"Error: {str(e)}", file=sys.stderr)
            sys.exit(1) # pyright: ignore
    else:
        print(f"Error: {str(e)}", file=sys.stderr)
        sys.exit(1) # pyright: ignore

        <mxCell id="Bf5ZN1ybasiH3Wv3YJtf-43" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;List of tasks performed by padsi-service:&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;remove all the resources associated with a zone (ZoneApps, FlatpakInstance, WaylandProxy, network and virtiofsd)&lt;/li&gt;&lt;li&gt;create user owned directories /run/padsi/user and /var/padsi/home&lt;/li&gt;&lt;li&gt;create zone directories (/var/padsi/applications, home, icons, logs, VM...)&lt;/li&gt;&lt;li&gt;setup ZoneInfra (privileged_setup())&lt;/li&gt;&lt;li&gt;update zone&#39;s color files&lt;/li&gt;&lt;li&gt;manage virtiofsd&lt;/li&gt;&lt;li&gt;manage common VM components (base, publish) use AdmnVMFiles&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-200" y="-475" width="270" height="290" as="geometry" />

        <mxCell id="G9rGvRg2WaalnpNGYD9z-20" value="Before updating the base VM, the admin has to list all the VM snapshots which use the VM file and decide what to do:&lt;div&gt;&lt;ul&gt;&lt;li&gt;force the update =&amp;gt; all subsequent snapshots will be useless&lt;/li&gt;&lt;li&gt;use symlinks the the base VM so that old versions still work&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=note;strokeWidth=2;fontSize=13;size=18;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;shadow=1;dashed=0;labelBackgroundColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;perimeterSpacing=0;spacingLeft=3;spacingBottom=3;spacingRight=3;spacing=10;" vertex="1" parent="1">

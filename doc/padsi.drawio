        <mxCell id="QZ9WYOj6Ox8oAKjVbFc--0" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;SystemService&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ul style=&quot;padding-left: 20px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;keeps track of which USB device is redirected to which VM (via their viewer PID) and by which user from events received by the USB devices monitor&lt;/span&gt;&lt;/li&gt;&lt;li&gt;allow reservation slots of 10&#39; by VMs&lt;/li&gt;&lt;li&gt;start/stop system&#39;s PCSCD:&lt;/li&gt;&lt;ul style=&quot;padding-left: 20px;&quot;&gt;&lt;li&gt;start if no smartcard is redirected anywhere&lt;/li&gt;&lt;li&gt;stop before allowing a smartcard to &quot;reserved&quot; by a VM&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;" parent="tm0HBvREOUNx_k9-izYH-1" vertex="1">
          <mxGeometry x="990" y="730" width="260" height="230" as="geometry" />
        </mxCell>
        <mxCell id="QZ9WYOj6Ox8oAKjVbFc--1" value="&lt;div style=&quot;forced-color-adjust: none; color: rgb(0, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(251, 251, 251); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; text-align: center;&quot;&gt;&lt;br&gt;&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;curved=1;" parent="tm0HBvREOUNx_k9-izYH-1" source="QZ9WYOj6Ox8oAKjVbFc--2" target="QZ9WYOj6Ox8oAKjVbFc--0" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QZ9WYOj6Ox8oAKjVbFc--2" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;UserService&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;" parent="tm0HBvREOUNx_k9-izYH-1" vertex="1">
          <mxGeometry x="1430" y="920" width="130" height="70" as="geometry" />
        </mxCell>
        <mxCell id="QZ9WYOj6Ox8oAKjVbFc--3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;curved=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="tm0HBvREOUNx_k9-izYH-1" source="fi2sxdA-ShGnz8fmgmSs-1" target="QZ9WYOj6Ox8oAKjVbFc--2" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1680" y="1001.3000000000002" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QZ9WYOj6Ox8oAKjVbFc--5" value="Notes:&lt;div&gt;&lt;ul style=&quot;padding-left: 20px;&quot;&gt;&lt;li&gt;the host PCSCD can only be running if NO VM actually perform smartcard redirection&lt;/li&gt;&lt;li&gt;VMs must allow device redirection only if not already redirected by another VM (=&amp;gt; ask before)&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;text-align: center;&quot;&gt;lsusb list devices&amp;nbsp;&lt;/span&gt;by &amp;lt;bus&amp;gt; and &amp;lt;device&amp;gt;&lt;/li&gt;&lt;li&gt;if needed, to known if redirected, run &quot;lsof -t&amp;nbsp;/dev/bus/usb/&amp;lt;bus&amp;gt;/&amp;lt;device&amp;gt;&quot; to get the PID of the process using the device (the Spice Viewer)&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;For the messages:&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul style=&quot;padding-left: 20px;&quot;&gt;&lt;li&gt;a device is identified by &amp;lt;bus&amp;gt;/&amp;lt;device&amp;gt; (like &quot;003:072&quot;) as returned by lsusb&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="tm0HBvREOUNx_k9-izYH-1" vertex="1">
          <mxGeometry x="580" y="420" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="QZ9WYOj6Ox8oAKjVbFc--6" value="informs&lt;div&gt;OPEN and CLOSE&lt;/div&gt;&lt;div&gt;events&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;curved=1;" parent="tm0HBvREOUNx_k9-izYH-1" source="QZ9WYOj6Ox8oAKjVbFc--7" target="QZ9WYOj6Ox8oAKjVbFc--0" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QZ9WYOj6Ox8oAKjVbFc--7" value="USB devices monitor" style="rounded=1;whiteSpace=wrap;html=1;" parent="tm0HBvREOUNx_k9-izYH-1" vertex="1">
          <mxGeometry x="1060" y="590" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fi2sxdA-ShGnz8fmgmSs-0" value="&lt;ul style=&quot;forced-color-adjust: none; color: rgb(0, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(251, 251, 251); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; padding-left: 20px;&quot;&gt;&lt;li style=&quot;forced-color-adjust: none;&quot;&gt;ask if a device is already being redirected by a VM somewhere&lt;/li&gt;&lt;li style=&quot;forced-color-adjust: none;&quot;&gt;reserve a 10&#39; slot to redirect a device (may fail if already being redirected by a VM).&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="tm0HBvREOUNx_k9-izYH-1" vertex="1">
          <mxGeometry x="1280" y="790" width="200" height="90" as="geometry" />

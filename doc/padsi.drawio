        <mxCell id="fi2sxdA-ShGnz8fmgmSs-2" value="&lt;ul style=&quot;forced-color-adjust: none; color: rgb(0, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(251, 251, 251); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; padding-left: 20px;&quot;&gt;&lt;li style=&quot;forced-color-adjust: none;&quot;&gt;ask if a device is already being redirected by a VM somewhere&lt;/li&gt;&lt;li style=&quot;forced-color-adjust: none;&quot;&gt;reserve a 10&#39; slot to redirect a device (may fail if already being redirected by a VM).&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="tm0HBvREOUNx_k9-izYH-1" vertex="1">

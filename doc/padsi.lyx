inline false
status open

\begin_layout Plain Layout

{
\end_layout

\begin_layout Plain Layout

    "ms365-exchange":
 {
\end_layout

\begin_layout Plain Layout

        "descr":
 "Exchange Online",
\end_layout

\begin_layout Plain Layout

        "endpoints":
 [
\end_layout

\begin_layout Plain Layout

            "13.107.6.152/31^tcp^80,443",
\end_layout

\begin_layout Plain Layout

            "13.107.18.10/31^tcp^80,443",
\end_layout

\begin_layout Plain Layout

            "13.107.128.0/22^tcp^80,443",
\end_layout

\end_inset


\end_layout

\begin_layout Subsubsection
Virtual machines configuration
\begin_inset CommandInset label
LatexCommand label
name "VM-conf"

\end_inset


\end_layout

\begin_layout Standard
A virtual machine is defined by a 
\family typewriter
.vm
\family default
 configuration file,
 the name of the file being the name of the virtual machine.
 It is a JSON file with the following top sections:
\end_layout

\begin_layout Itemize

\family typewriter
"specs"
\family default
,
 which contain the specifications of the virtual machine:
\end_layout

\begin_deeper
\begin_layout Itemize

\family typewriter
"descr"
\family default
:
 a human readable description of the VM,
\end_layout

\begin_layout Itemize

\family typewriter
"variant"
\family default
:
 the OS in the 
\family typewriter
<OS type>/<OS version>
\family default
 where the OS type is 
\begin_inset Quotes eld
\end_inset

windows
\begin_inset Quotes erd
\end_inset

 or 
\begin_inset Quotes eld
\end_inset

linux
\begin_inset Quotes erd
\end_inset

,
 and the OS version in the form 
\family typewriter
<OS distribution>[/<number>]
\family default
,
 for example:
 
\begin_inset Quotes eld
\end_inset

windows/10
\begin_inset Quotes erd
\end_inset

,
 
\begin_inset Quotes eld
\end_inset

windows/11
\begin_inset Quotes erd
\end_inset

,
 
\begin_inset Quotes eld
\end_inset

linux/debian
\begin_inset Quotes erd
\end_inset

,
 
\begin_inset Quotes eld
\end_inset

linux/debian/12
\begin_inset Quotes erd
\end_inset

.
\end_layout

\begin_layout Itemize

\family typewriter
"disk-size-mb"
\family default
:
 the virtual dist size in Mb;
\end_layout

\begin_layout Itemize

\family typewriter
"mem-mb"
\family default
:
 the memory size,
 in Mb;
\end_layout

\begin_layout Itemize

\family typewriter
"nb-cpu"
\family default
:
 the number of CPUs allocated to the VM;
\end_layout

\begin_layout Itemize

\family typewriter
"secure-boot"
\family default
:
 true if Secure Boot is enabled.
\end_layout

\end_deeper
\begin_layout Itemize

\family typewriter
"admin"
\family default
,
 which contains references to scripts used when booting or stopping the VM,
 depending on the context in which the VM is running.
 There can be a script name associated with each 
\family typewriter
<context>-script
\family default
 key,
 the associated scripts will be searched in PADSI's 
\family typewriter
vm-management/scripts/<OS type>
\family default
 directory.
 The contexts are:
\end_layout

\begin_deeper
\begin_layout Itemize

\family typewriter
"update"
\family default
:
 when the VM is being updated;
\end_layout

\begin_layout Itemize

\family typewriter
"customize"
\family default
:
 the transient state when the VM is being customized for a user;
\end_layout

\begin_layout Itemize

\family typewriter
"run"
\family default
:
 when the VM is being used by a user
\end_layout

\begin_layout Itemize

\family typewriter
"shutdown"
\family default
:
 when the VM is being shut down.
\end_layout

\end_deeper
\begin_layout Itemize

\family typewriter
"install"
\family default
,
 
\family typewriter
"update"
\family default
,
 and 
\family typewriter
"run"
\family default
:
 contain the constraints on the VM when is it respectively installed,
 updated and customized or run by the user.
 The contents of these sections is:
\end_layout

\begin_deeper
\begin_layout Itemize

\family typewriter
"allowed-users"
\family default
:
 users (the root user is always allowed) which are allowed to use the VM in the associated context,
 as:
\end_layout

\begin_deeper
\begin_layout Itemize
a list of user names or group names (which must be prefixed by the 
\begin_inset Quotes eld
\end_inset


\family typewriter
%
\family default

\begin_inset Quotes erd
\end_inset

 character);
\end_layout

\begin_layout Itemize
null to allow all users.
\end_layout

\end_deeper
\begin_layout Itemize

\family typewriter
"with-net"
\family default
:
 true if the VM has network access;
\end_layout

\begin_layout Itemize

\family typewriter
"show-ui"
\family default
:
 true if the VM's UI is shown when it starts;
\end_layout

\begin_layout Itemize

\family typewriter
"network"
\family default
:
 a network configuration,
 using the same syntax as for the zones' configuration (refer to section 
\begin_inset CommandInset ref
LatexCommand ref
reference "zones-configuration"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) but with only the rules taken into account (refer to section 
\begin_inset CommandInset ref
LatexCommand ref
reference "network-rules"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

)
\end_layout

\begin_layout Itemize

\family typewriter
"mounts"
\family default
:
 allowed only when usage is 
\family typewriter
"run",

\family default
 list of directories mounted in the virtual machine,
 in the same way as the ones for the zones (refer to section 
\begin_inset CommandInset ref
LatexCommand ref
reference "zones-configuration"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) with however the following difference:
 mounted directories can be outside of the user's home directory (or profile) if the path is a full path.
\end_layout

\end_deeper
\begin_layout Subsubsection
Administration namespaces' configuration
\begin_inset CommandInset label
LatexCommand label
name "admin-ns-configuration"

\end_inset


\end_layout

\begin_layout Standard
Administration namespaces allow remote access and local administration of a PADSI system,
 refer to section 
\begin_inset CommandInset ref
LatexCommand ref
reference "sys-admin"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 for more details.
 Each administration namespace is defined by a single file named 
\family typewriter
<name>.admns
\family default
 (the name must start with a lower case letter and contain only lower case letters and numbers) which is a JSON file containing the following keys:
\end_layout

\begin_layout Itemize

\family typewriter
"friendly-name"
\family default
:
 the user friendly name of the zone;
\end_layout

\begin_layout Itemize

\family typewriter
"traffic-shaper"
\family default
:
 name of the traffic shaper to use,
 if any.
\end_layout

\begin_layout Itemize

\family typewriter
"network"
\family default
:
 specifies the network settings of the zone (set to 
\family typewriter
null
\family default
 to disable networking in the zone),
 as the following keys:
\end_layout

\begin_deeper
\begin_layout Itemize

\family typewriter
"dns-resolvers"
\family default
:
 list of the DNS resolvers to use,
 like 
\family typewriter
["8.8.8.8",
 "1.1.1.1"]
\family default
 for example,
 or 
\family typewriter
null
\family default
 to avoid querying any DNS resolver (local static DNS resolution can still provided).
\end_layout

\begin_deeper
\begin_layout Standard
DNS over TLS (DoT) is also supported,
 for example 
\family typewriter
["86.54.11.213@853",
 "86.54.11.13@853"]
\family default
 to use the EU's DNS' privacy and security focused resolvers
\begin_inset Foot
status collapsed

\begin_layout Plain Layout
DNS4EU ,
 refer to https://www.joindns4.eu/
\end_layout

\end_inset

.
\end_layout

\begin_layout Standard
The following syntaxes are supported to specify a single resolver:
 
\family typewriter
<IP address>[@<port>][@<protocol>]
\family default
 where the protocol can be 
\begin_inset Quotes eld
\end_inset

DoT
\begin_inset Quotes erd
\end_inset

 for DNS over TLS.
\end_layout

\end_deeper
\begin_layout Itemize

\family typewriter
\begin_inset Quotes eld
\end_inset

out-rules
\begin_inset Quotes erd
\end_inset


\family default
:
 list of applicable outbound filtering rules for the zone,
 refer to section 
\begin_inset CommandInset ref
LatexCommand ref
reference "network-rules"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 for the syntax of each rule.
 The filtering decision is the action specified in the first matching rule,
 and a deny if no rule matched;
\end_layout

\begin_layout Itemize

\family typewriter
\begin_inset Quotes eld
\end_inset

in-rules
\begin_inset Quotes erd
\end_inset


\family default
:
 list of applicable inbound filtering rules for the zone,
 where only IP based filtering is allowed,
 refer to section 
\begin_inset CommandInset ref
LatexCommand ref
reference "network-rules"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 for the syntax of each rule.
 The filtering decision is the action specified in the first matching rule,
 and a deny if no rule matched.
\end_layout

\end_deeper
\begin_layout Itemize

\family typewriter
"web-proxy"
\family default
:
 can be 
\family typewriter
null
\family default
 or can specify if a forwarding Web proxy,
 refer to section 
\begin_inset CommandInset ref
LatexCommand ref
reference "zones-configuration"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 for the syntax.
\end_layout

\begin_layout Subsection
Patching / new versions of PADSI
\end_layout

\begin_layout Standard
update the package normally and restart the service.
\end_layout

\begin_layout Standard
ATTN:
 any user run program will be closed
\end_layout

\begin_layout Subsection
System administration
\end_layout

\begin_layout Subsubsection
Remote access
\begin_inset CommandInset label
LatexCommand label
name "remote-access-config"

\end_inset


\end_layout

\begin_layout Standard
Remote access to a PADSI system is often required for administration purposes (to apply policies,
 perform verifications,
 install packages,
 ...);
 refer to section 
\begin_inset CommandInset ref
LatexCommand ref
reference "sys-admin"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 for more explanations about the specificities of a PADSI system.
 This section details how to set up a remote access to a PADSI system.
\end_layout

\begin_layout Standard
The first thing is to determine the network(s) on which PADSI systems will be connected and where remote access will be performed,
 for example:
\end_layout

\begin_layout Itemize
corporate networks:
 in this case,
 a remote access to a PADSI system will only be possible when the system is physically present within the premises of the enterprise;
\end_layout

\begin_layout Itemize
the open Internet:
 in this case,
 one needs to find a way to get the IP address of a PADSI system 
\begin_inset Quotes eld
\end_inset

wherever
\begin_inset Quotes erd
\end_inset

 it is (at a home location,
 an Internet cafe,
 within the premises of the enterprise,
 ...) maybe using some sort of dynamic DNS;
\end_layout

\begin_layout Itemize
via VPN:
 this is the most convenient way for remote access as remote access will be possible in every situation provided that the PADSI has access to the Internet and/or the VPN server,
 but requires to set up a VPN server.
\end_layout

\begin_layout Standard
From the perspective of PADSI's configuration,
 remote access is configured by creating one or more administration namespace configuration (refer to section 
\begin_inset CommandInset ref
LatexCommand ref
reference "admin-ns-configuration"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 for the details) for each of the remote access situations above (or others),
 which are not exclusive.
\end_layout

\begin_layout Standard
PADSI will configure the networking stack to allow incoming traffic,
 but will not set up any listening service,
 this action must be done manually or via automatic configuration tools like Ansible.
 The remaining of this section illustrates how to set up an SSH service within an administration namespace named 
\begin_inset Quotes eld
\end_inset

remote-access
\begin_inset Quotes erd
\end_inset

 here (to be adapted for other services).
\end_layout

\begin_layout Standard
The steps are:
\end_layout

\begin_layout Itemize
presumably (except if the SSH service must still be run in the 
\begin_inset Quotes eld
\end_inset

init
\begin_inset Quotes erd
\end_inset

 namespaces and PADSI's global configuration allows it) stop and disable the SSH service:
\begin_inset listings
lstparams "basicstyle={\footnotesize\ttfamily}"
inline false
status open

\begin_layout Plain Layout

# systemctl stop ssh.service
\end_layout

\begin_layout Plain Layout

# systemctl disable ssh.service
\end_layout

\end_inset


\end_layout

\begin_layout Itemize
create an ssh service template dedicated to PADSI (the template will be instantiated per administration namespace used),
 for example 
\begin_inset Quotes eld
\end_inset

padsi-ssh@
\begin_inset Quotes erd
\end_inset

:
\begin_inset listings
lstparams "basicstyle={\footnotesize\ttfamily}"
inline false
status open

\begin_layout Plain Layout

# cp /lib/systemd/system/ssh.service /etc/systemd/system/ssh-padsi@.service
\end_layout

\end_inset


\end_layout

\begin_layout Itemize
adapt the template using the 
\family typewriter
%i
\family default
 placeholder (which will contain the value of the template when used),
 specifically to:
\end_layout

\begin_deeper
\begin_layout Itemize
run the ssh daemon via the 
\family typewriter
padsi-do
\family default
 tool to which the administration namespace is passed as an argument (the 
\family typewriter
--adminns
\family default
 argument);
\end_layout

\begin_layout Itemize
if necessary adapt the environment variables in a dedicated 
\family typewriter
/etc/default/ssh-padsi-%i
\family default
 file where the listening port number may be specified like 
\family typewriter
SSHD_OPTS=-p 2222
\family default
;
\end_layout

\begin_layout Standard
for example the modifications might look like:
\begin_inset listings
lstparams "basicstyle={\footnotesize\ttfamily}"
inline false
status open

\begin_layout Plain Layout

EnvironmentFile=-/etc/default/ssh-padsi-%i
\end_layout

\begin_layout Plain Layout

ExecStart=/usr/bin/padsi-do --adminns %i /usr/sbin/sshd -D $SSHD_OPTS
\end_layout

\end_inset


\end_layout

\end_deeper
\begin_layout Itemize
ask systemd to take into account the new configuration:
\begin_inset listings
lstparams "basicstyle={\footnotesize\ttfamily}"
inline false
status open

\begin_layout Plain Layout

# systemctl daemon-reload
\end_layout

\end_inset


\end_layout

\begin_layout Itemize
start,
 test,
 and then enable the SSH service for each administration namespace:
\begin_inset listings
lstparams "basicstyle={\footnotesize\ttfamily}"
inline false
status open

\begin_layout Plain Layout

# systemctl start padsi-ssh@remote-access
\end_layout

\begin_layout Plain Layout

# systemctl status padsi-ssh@remote-access
\end_layout

\begin_layout Plain Layout

ssh-padsi@remote-access.service - OpenBSD Secure Shell server
\end_layout

\begin_layout Plain Layout

     Loaded:
 loaded (/etc/systemd/system/ssh-padsi@.service;
 disabled;
 preset:
 enabled)
\end_layout

\begin_layout Plain Layout

     Active:
 active (running) since Thu 2025-12-04 10:04:22 CET;
 18min ago
\end_layout

\begin_layout Plain Layout

 Invocation:

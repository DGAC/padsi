	filename padsi-user-service.png
	width 70col%

\end_inset


\end_layout

\begin_layout Standard

\bar under
Note
\bar default
:
 the detection of a user opening a graphical session or closing it is based on the presence of a GNOME Shell process for each user.
 Using the presence of a per user 
\family typewriter
/run/user/<UID>
\family default
 directory is not a good enough indicator.
\end_layout

